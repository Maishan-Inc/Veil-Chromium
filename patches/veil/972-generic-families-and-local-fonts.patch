 namespace blink {
 
+namespace {
+
+// Veil 972: the face the claimed platform's Chrome resolves this generic to, or empty to leave the
+// host's Settings value in place. The order of the tests below mirrors the desktop branch of
+// FamilyNameFromSettings exactly -- standard and -webkit-standard first, then the keywords -- so the
+// substitution happens for the same requests the settings lookup would have answered, and for no
+// others.
+std::string VeilClaimedGenericFamily(const FontDescription& font_description,
+                                     const AtomicString& generic_family_name) {
+  using Generic = ungoogled::font_persona::Generic;
+  if (font_description.GenericFamily() == FontDescription::kStandardFamily ||
+      font_description.GenericFamily() == FontDescription::kWebkitBodyFamily ||
+      generic_family_name == font_family_names::kWebkitStandard) {
+    return ungoogled::font_persona::ClaimedGenericFamily(Generic::kStandard);
+  }
+  if (generic_family_name == font_family_names::kSerif) {
+    return ungoogled::font_persona::ClaimedGenericFamily(Generic::kSerif);
+  }
+  if (generic_family_name == font_family_names::kSansSerif) {
+    return ungoogled::font_persona::ClaimedGenericFamily(Generic::kSansSerif);
+  }
+  if (generic_family_name == font_family_names::kMonospace) {
+    return ungoogled::font_persona::ClaimedGenericFamily(Generic::kFixed);
+  }
+  return std::string();
+}
