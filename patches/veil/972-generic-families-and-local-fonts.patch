+// Veil 972: the same membership decision, for the one other API that enumerates families.
+//
+// `queryLocalFonts()` reads a table the browser process built from the real operating system, so
+// without this it answers "which fonts does this machine have" with the host's set while CSS answers
+// with the claimed platform's -- and a page can ask both in the same function. Declared in
+// veil_font_claim.h; defined here because the three tables are here.
+//
+// Both branches mirror GetFontPlatformData below rather than restating a rule: cross-platform, a family
+// is presented iff the claimed platform's table lists it; same-platform, everything is presented except
+// a face that belongs to another platform's table, which is the one contradiction the host's own list
+// can carry. There is no substitution rung, because a name is all this API returns.
+bool VeilClaimedPlatformPresentsFamily(const std::string& font_family) {
+  if (!ungoogled::platform_claim::SeedPresent() ||
+      ungoogled::platform_claim::SpoofingDisabled("font")) {
+    return true;
+  }
+  const std::string claimed = ungoogled::platform_claim::Claimed();
+  const std::string host = ungoogled::platform_claim::Host();
+  if (claimed != host) {
+    return VeilPlatformPresentsFamily(GetPlatformFonts(claimed), font_family);
+  }
+  return VeilPlatformPresentsFamily(GetPlatformFonts(host), font_family) ||
+         !VeilFamilyBelongsToAnotherPlatform(claimed, font_family);
+}
