diff --git a/components/ungoogled/font_persona.h b/components/ungoogled/font_persona.h
new file mode 100644
index 0000000000..d5aa30571f
--- /dev/null
+++ b/components/ungoogled/font_persona.h
@@ -0,0 +1,111 @@
+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Which face the claimed platform's Chrome resolves each CSS generic to.
+//
+// `serif`, `sans-serif` and `monospace` are not names a page reads back -- `getComputedStyle` returns
+// the keyword, never the resolved family -- so what is observable here is *metrics*: the width and
+// height of a string set in each generic. That makes two things worth having and one thing impossible:
+//
+//   worth having   -- the three generics must not collapse onto one face. Measured on the shipping
+//                     engine under the `persona` case: `monospace` and `serif` both report 1009x80,
+//                     i.e. a machine whose fixed-width font is Times New Roman. The cause is narrower
+//                     than 6.8 predicted and was measured rather than assumed: `--lang=en-US` moves
+//                     Chrome's own font preferences to the English set, so the host's families are
+//                     already `Times New Roman`, `Arial` and **`Consolas`** -- and `Consolas` is a
+//                     ClearType face no macOS table lists, so `906` hides it and the generic falls
+//                     through to the standard family. (On a host whose UI locale is not English the
+//                     localised names 6.8 describes -- "宋体", "微软雅黑" -- hide all three the same
+//                     way, which is the `default` case rather than a persona.)
+//   worth having   -- `monospace` must be monospaced. A proportional face behind that keyword is both
+//                     a tell and a visible defect on every `<pre>` on the page.
+//   impossible     -- the exact metrics of a Mac's Times or Helvetica, on a host that has neither.
+//                     That is `906`'s advance-width residual, and it is unchanged by this patch.
+//
+// THE TABLE IS CHROMIUM'S OWN, per platform: `chrome/app/resources/locale_settings_mac.grd` and
+// `locale_settings_linux.grd` are where Chrome's default generic families are declared, so "what does
+// a Mac's Chrome resolve `serif` to" is answered by the source rather than by a guess --
+// `IDS_SERIF_FONT_FAMILY` is `Times` on macOS, `Times New Roman` on Linux and Windows,
+// `IDS_SANS_SERIF_FONT_FAMILY` is `Helvetica` / `Arial`, `IDS_FIXED_FONT_FAMILY` is `Menlo` /
+// `Monospace` / `Courier New`.
+//
+// ONE DELIBERATE DEVIATION FROM THAT TABLE, and it is the monospace row. The grd says `Menlo`, which
+// this host does not have and cannot alias, so `906`'s cross-platform branch would substitute a
+// host face chosen by a seed hash -- possibly a proportional one, for the keyword whose whole meaning
+// is that it is not. `Courier` is sent instead: a family macOS genuinely ships, and one Blink aliases
+// to `Courier New` on Windows (`AlternateFamilyName()`), so the generic keeps its *class* on this host
+// while still naming a face the claimed platform has. The name is not observable; the class is.
+//
+// THREE ROWS DELIBERATELY LEFT ALONE:
+//
+// - `cursive` and `fantasy`. This host resolves them to `Comic Sans MS` and `Impact`, which are
+//   Microsoft's cross-platform Office faces and are in `006`'s macOS table for exactly that reason, so
+//   the values a Mac persona already reports are families a Mac with Office has -- and they measure
+//   distinct (975x90 and 1145x95). Replacing them with `Apple Chancery` and `Papyrus` would trade two
+//   plausible resolved faces for two seed-chosen substitutes.
+// - `math`. `STIX Two Math` has no host face and no alias, so the substitution would change one
+//   fallback for another.
+// - Every **script-specific** row. `FamilyNameFromSettings` is script-aware, and the grd carries
+//   Japanese, Korean, Han and Devanagari rows -- but for a cross-platform claim both sides of that
+//   choice end up at the same place on this host: the claimed CJK face (`PingFang SC`,
+//   `Hiragino Kaku Gothic ProN`) is absent here, and the host's own (`宋体`, `Yu Gothic`) is hidden by
+//   `906`. Nothing observable changes, so nothing is claimed. A macOS *host* would need them.
+
+#ifndef COMPONENTS_UNGOOGLED_FONT_PERSONA_H_
+#define COMPONENTS_UNGOOGLED_FONT_PERSONA_H_
+
+#include <string>
+
+#include "components/ungoogled/platform_claim.h"
+
+namespace ungoogled {
+namespace font_persona {
+
+// The CSS generics this header speaks for. `kStandard` covers `-webkit-standard` and the default
+// font, which Blink resolves through the same settings call.
+enum class Generic { kStandard, kSerif, kSansSerif, kFixed };
+
+// The family Chrome on the claimed platform defaults to for `generic`, or empty to leave the host's
+// setting in place -- which is the answer for a same-platform claim, a missing seed,
+// `--disable-spoofing=font`, and for every generic not in the enum above.
+inline std::string ClaimedGenericFamily(Generic generic) {
+  if (!platform_claim::ShouldPresentOtherPlatform("font")) {
+    return std::string();
+  }
+  const std::string claimed = platform_claim::Claimed();
+  if (claimed == "macos") {
+    switch (generic) {
+      case Generic::kStandard:
+      case Generic::kSerif:
+        return "Times";
+      case Generic::kSansSerif:
+        return "Helvetica";
+      case Generic::kFixed:
+        // The grd says `Menlo`; see the header comment for why this is `Courier`.
+        return "Courier";
+    }
+    return std::string();
+  }
+  if (claimed == "linux") {
+    switch (generic) {
+      case Generic::kStandard:
+      case Generic::kSerif:
+        return "Times New Roman";
+      case Generic::kSansSerif:
+        return "Arial";
+      case Generic::kFixed:
+        // `locale_settings_linux.grd` says `Monospace`, which is fontconfig's alias rather than a
+        // face; on a non-Linux host it resolves to nothing. `DejaVu Sans Mono` is the face fontconfig
+        // points that alias at on every mainstream distribution, and it is in `006`'s Linux table.
+        return "DejaVu Sans Mono";
+    }
+    return std::string();
+  }
+  return std::string();
+}
+
+}  // namespace font_persona
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_FONT_PERSONA_H_

