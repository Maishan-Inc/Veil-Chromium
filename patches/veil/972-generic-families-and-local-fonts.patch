+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Does the claimed platform present this family? One declaration, so that a second consumer of
+// `006`'s membership rule does not need a second copy of `006`'s tables.
+//
+// `queryLocalFonts()` is that second consumer, and it is the hole `972` closes: the enumerable set a
+// page measures through CSS goes through `FontCache::GetFontPlatformData`, where `006` and `906`
+// answer for the claimed platform, while `queryLocalFonts()` reads a table the browser process built
+// from the real operating system and routes around them entirely. Two answers to "which fonts does
+// this machine have", and the second one is the host's.
+//
+// The definition lives in `font_cache.cc` because that is where the three platform tables are -- 541
+// family names per platform, materialised once -- and moving them would mean editing a ported patch's
+// data rather than adding to it.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_VEIL_FONT_CLAIM_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_VEIL_FONT_CLAIM_H_
+
+#include <string>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink {
+
+// True when `family` is a name the claimed platform's font list presents, by exactly the rule `006`
+// and `906` apply in `FontCache`: on a cross-platform claim, membership of the claimed platform's
+// table; on a same-platform claim, everything except a face that belongs to a *different* platform's
+// table. Always true when no seed is present or `--disable-spoofing=font` is set.
+//
+// `std::string` rather than `WTF::String` on purpose: the one caller has the name as a `std::string`
+// out of a protobuf, and the tables it is compared against are `std::string` too.
+PLATFORM_EXPORT bool VeilClaimedPlatformPresentsFamily(const std::string& family);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_VEIL_FONT_CLAIM_H_

