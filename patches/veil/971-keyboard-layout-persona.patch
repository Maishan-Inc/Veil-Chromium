+
+const VeilKeyboardLayout* VeilKeyboardLayoutForLanguage(
+    const std::string& language) {
+  for (const VeilKeyboardLayout& layout : kVeilKeyboardLayouts) {
+    if (language == layout.language) {
+      return &layout;
+    }
+  }
+  return nullptr;
+}
+
 base::flat_map<std::string, std::string>
 RenderWidgetHostViewAura::GetKeyboardLayoutMap() {
   aura::WindowTreeHost* host = window_->GetHost();
-  if (host)
-    return host->GetKeyboardLayoutMap();
-  return {};
+  base::flat_map<std::string, std::string> dom_map =
+      host ? host->GetKeyboardLayoutMap() : base::flat_map<std::string, std::string>();
+
+  // Veil 971: the layout map is the host's otherwise -- every persona reports the physical
+  // keyboard this machine happens to have, which is how a macOS persona on this build host
+  // reported 48 keys of US-QWERTY (T22, Veil/docs/MIGRATION-UNGOOGLED.md 6.22). When a persona is
+  // presented and its locale claims a layout this table knows, the writing-system keys are
+  // answered from the claimed layout's own map instead. Controls (Shift, Enter, the arrows) are
+  // identical across these layouts and are left as the host answered them; a locale with no table
+  // leaves the host map untouched, because a wrong map is a stronger tell than a stale one.
+  // clearcote's `150` pins one US-QWERTY map for every claim; following the locale is Veil's.
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line || !command_line->HasSwitch(switches::kFingerprint) ||
+      !command_line->HasSwitch(switches::kLang)) {
+    return dom_map;
+  }
+  const std::string lang =
+      base::ToLowerASCII(command_line->GetSwitchValueASCII(switches::kLang));
+  const std::string language = lang.substr(0, lang.find('-'));
+  const VeilKeyboardLayout* layout = VeilKeyboardLayoutForLanguage(language);
+  if (!layout) {
+    return dom_map;
+  }
+  for (const VeilLayoutEntry& entry : layout->entries) {
+    // Substitute only: the *values* follow the claimed layout, while the *key set* stays the
+    // host's hardware -- which keys exist (the 102nd key, JIS ro) is what the machine physically
+    // has, and a persona claiming fewer keys than its own hardware reports is a second tell the
+    // value table must not buy. Codes the host map does not carry are skipped, so this can
+    // neither insert a key the machine lacks nor widen the map.
+    dom_map[entry.code] = entry.key;
+  }
+  return dom_map;
 }
 
