+// Veil 971: unshifted writing-system keys for the layouts a persona can claim through its locale
+// (`--lang`, which is also what `972`'s generic families and `968`'s default voice follow -- one
+// locale, one set of OS-configured answers). Key names are the DOM code strings
+// `KeyboardLayoutMap` reports. Each table is the layout's own unshifted mapping -- the values
+// Windows produces for its "US", "German", "French" and "Russian" layouts, the same question
+// `dom_keyboard_layout_map_win.cc` asks `ToUnicodeEx` -- and the application below substitutes
+// these values into the host's map, which leaves the *key set* (a hardware fact: which physical
+// keys exist) and the control keys (Shift, Enter, the arrows: identical across these layouts) as
+// the host answered them. `en` and `zh` share the US table because a zh-* locale's IME sits on
+// US-QWERTY hardware, and the remaining Latin locales answer from it too; that simplification is
+// recorded here rather than modelled as separate layouts this tree cannot verify. Non-Latin
+// letters are written as their UTF-8 byte escapes so the file stays ASCII.
+struct VeilLayoutEntry {
+  const char* code;
+  const char* key;
+};
+
+struct VeilKeyboardLayout {
+  const char* language;
+  base::span<const VeilLayoutEntry> entries;
+};
