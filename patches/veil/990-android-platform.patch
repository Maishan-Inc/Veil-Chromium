+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The phone table -- one data header, three rows, no logic beyond the pick.
+//
+// Each row is an ATOMIC, mutually-consistent phone profile: model, Android version,
+// portrait screen + DPR, touch count, GPU IHV + ANGLE-wrapped GLES renderer, cores, RAM and
+// colour gamut are drawn TOGETHER so no surface can contradict another (a Pixel model never
+// pairs with an Adreno string). That atomicity is the whole point of a table: the same row
+// answers UA-CH, WebGL, touch and netinfo, so one seed cannot put a Pixel 7's model beside
+// a Galaxy's GPU.
+//
+// Rows and weights are clearcote's (002), and they are public hardware specifications
+// rather than measurements anyone has to take on faith: Pixel 7 (Tensor G2, Mali-G710,
+// 1080x2400 panel at 2.625x -> 412x915 CSS, 8 cores, 8 GB, Android 14); Galaxy S23
+// (SM-S911B, Snapdragon 8 Gen 2 for Galaxy, Adreno 740, 1080x2340 at 3.0x -> 360x780 CSS,
+// 8 GB, Android 14); Galaxy A54 (SM-A546B, Exynos 1380, Mali-G68 MC4, 1080x2340 at 2.625x
+// -> 412x892 CSS, 8 GB, Android 14). All three are OLED P3 (color-gamut: p3) and
+// five-touch. The screen/DPR pairs are the CSS values Chrome on each device reports; the
+// renderer strings are the ANGLE form WebGL reports on Android ("ANGLE (vendor, renderer,
+// OpenGL ES 3.2)"). Weights 0.50 / 0.30 / 0.20: the flagships the population skews to, with
+// the A54 the mid-tier counterweight.
+//
+// THE PICK IS PURE. `DeviceForSeed` mixes the seed the splitmix64 way clearcote's
+// DerivePersona does, so the browser process and every renderer derive the same row from
+// --fingerprint=<seed> with no shared state -- the same property 011's `fingerprint % count`
+// has, and the reason there is no RNG and no mutable state anywhere in this header.
+//
+// The screen pair in a row is DATA FOR THE LAUNCHER (T24-b derives --window-size and the
+// panel switches from it), not a second screen source in the engine: the engine's display
+// surfaces answer only from 960's switches. This header exists so both sides of that
+// coupling read one table.
+
+#ifndef COMPONENTS_UNGOOGLED_ANDROID_DEVICE_DATA_H_
+#define COMPONENTS_UNGOOGLED_ANDROID_DEVICE_DATA_H_
+
+#include <cstdint>
+
+namespace ungoogled {
+namespace android_device {
+
+struct AndroidDevice {
+  const char* model;             // UA-CH model, e.g. "Pixel 7"
+  const char* platform_version;  // UA-CH platformVersion, e.g. "14.0.0"
+  int screen_w;                  // CSS px, portrait (what screen.width reports)
+  int screen_h;
+  double dpr;                    // devicePixelRatio
+  int max_touch;                 // navigator.maxTouchPoints
+  int hc;                        // hardwareConcurrency
+  int mem_gb;                    // deviceMemory (Chromium reports at most 8)
+  const char* gl_vendor;         // WebGL UNMASKED_VENDOR_WEBGL
+  const char* gl_renderer;       // WebGL UNMASKED_RENDERER_WEBGL (ANGLE-wrapped GLES)
+  int gl_max_texture_size;       // GL_MAX_TEXTURE_SIZE (flagship 16384, mid-tier 8192)
+  const char* color_gamut;       // CSS color-gamut
+};
+
+struct WeightedDevice {
+  AndroidDevice device;
+  int weight;  // out of 100
+};
+
+inline constexpr WeightedDevice kAndroidDevices[] = {
+    {{"Pixel 7", "14.0.0", 412, 915, 2.625, 5, 8, 8, "Google Inc. (ARM)",
+      "ANGLE (ARM, Mali-G710, OpenGL ES 3.2)", 16384, "p3"},
+     50},
+    {{"SM-S911B", "14.0.0", 360, 780, 3.0, 5, 8, 8, "Google Inc. (Qualcomm)",
+      "ANGLE (Qualcomm, Adreno (TM) 740, OpenGL ES 3.2)", 16384, "p3"},
+     30},
+    {{"SM-A546B", "14.0.0", 412, 892, 2.625, 5, 8, 8, "Google Inc. (ARM)",
+      "ANGLE (ARM, Mali-G68 MC4, OpenGL ES 3.2)", 8192, "p3"},
+     20},
+};
+
+inline constexpr int kTotalWeight = 100;
+
+// splitmix64, the same mixing clearcote's DerivePersona uses: weak seeds (1, 2, 3)
+// otherwise land on adjacent picks. Pure -- no RNG object, no state, same answer in every
+// process and across restarts.
+inline uint64_t MixSeed(uint32_t seed) {
+  uint64_t mixed = static_cast<uint64_t>(seed) + 0x9E3779B97F4A7C15ull;
+  mixed = (mixed ^ (mixed >> 30)) * 0xBF58476D1CE4E5B9ull;
+  mixed = (mixed ^ (mixed >> 27)) * 0x94D049BB133111EBull;
+  return mixed ^ (mixed >> 31);
+}
+
+// The row this seed presents. Deterministic across processes and restarts.
+inline const AndroidDevice& DeviceForSeed(uint32_t seed) {
+  const uint64_t mixed = MixSeed(seed);
+  int pick = static_cast<int>(mixed % kTotalWeight);
+  for (const WeightedDevice& entry : kAndroidDevices) {
+    pick -= entry.weight;
+    if (pick < 0) {
+      return entry.device;
+    }
+  }
+  return kAndroidDevices[0].device;
+}
+
+}  // namespace android_device
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_ANDROID_DEVICE_DATA_H_
