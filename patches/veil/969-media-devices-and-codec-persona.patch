diff --git a/components/ungoogled/media_persona.h b/components/ungoogled/media_persona.h
new file mode 100644
index 0000000000..e3b8b4d0b1
--- /dev/null
+++ b/components/ungoogled/media_persona.h
@@ -0,0 +1,166 @@
+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// What the claimed machine can decode, and which media devices it has.
+//
+// Three call sites in two processes: `media/base/supported_types.cc` answers `canPlayType` and
+// `MediaSource.isTypeSupported`, `modules/media_capabilities` answers `decodingInfo()`'s
+// `powerEfficient`, and `content/browser/.../media_devices_manager.cc` answers
+// `enumerateDevices()`. One header so the three cannot disagree: a machine that reports HEVC
+// unsupported and HEVC power-efficient in the same breath is worse than one that reports neither.
+//
+// The codec claims are kept as narrow as the evidence. Two of them are properties of *Chromium* and
+// are cited to this tree; two are properties of Apple's video engine and are stated as such:
+//
+//   HEVC   -- macOS reaches HEVC through VideoToolbox, and Chromium asks the OS whether the hardware
+//             has it (`media/gpu/mac/video_toolbox_video_decoder.cc:67-71` behind
+//             `ENABLE_HEVC_PARSER_AND_HW_DECODER`, feeding the supplemental profile cache that
+//             `media/base/supported_types.cc:243` reads). Every Mac Apple has shipped since Kaby Lake
+//             answers yes, Apple Silicon included, so a Mac claim commits to HEVC Main and Main10.
+//   H.264  -- `SupportsH264()` is `VTIsHardwareDecodeSupported(kCMVideoCodecType_H264)`
+//             (`video_toolbox_video_decoder.cc:44`), true on every Mac.
+//   VP8    -- there is no VideoToolbox VP8 path in this tree at all, so never hardware.
+//   VP9    -- gated on `VTRegisterSupplementalVideoDecoderIfAvailable` plus
+//             `VTIsHardwareDecodeSupported` (`:48-61`), i.e. on the part. Apple Silicon has no VP9
+//             decode block, so this claims **software**: the conservative direction, and the one that
+//             matches every M-series Mac.
+//   AV1    -- hardware on the M3 and M4 families and on nothing older, so this is keyed on the Apple
+//             part `011` picked for the seed. That is the cross-check T11 exists to make: the codec
+//             answer and the renderer string are two reads of one machine.
+//
+// The device roster is the other half. Pre-permission Chrome exposes at most one device per *kind*
+// with an empty label and an empty `deviceId` -- measured on this host, where the only kind present is
+// `audiooutput`, count 1. A laptop persona has a built-in microphone, a built-in camera and built-in
+// speakers, so the claim is one of each: three kinds, still blank, which is what a MacBook reports
+// before a permission prompt.
+
+#ifndef COMPONENTS_UNGOOGLED_MEDIA_PERSONA_H_
+#define COMPONENTS_UNGOOGLED_MEDIA_PERSONA_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/ungoogled/fingerprint_data.h"
+#include "components/ungoogled/platform_claim.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+namespace ungoogled {
+namespace media_persona {
+
+// The five families the probe asks about, which are also the five `MediaCapabilities` is asked about
+// in practice. A `media::VideoCodec` cannot be named here: `media/base` includes this header, so
+// naming its types would close a dependency cycle.
+enum class VideoFamily { kH264, kHEVC, kVP8, kVP9, kAV1 };
+
+// The Apple part `011` picked for this seed, or empty when no Mac is claimed.
+//
+// `011` selects with `fingerprint % kMacosGpuModelCount` over the table in `fingerprint_data.h`
+// (`third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc`, `GetGLRendererString`), and the seed
+// is parsed with `base::StringToUint`. Reproduced here rather than re-derived: the table is the one
+// source, and reading it with the same index is reading that source. The formula belongs in one place
+// eventually -- the same follow-up `platform_claim.h` records for `display_persona.h`'s copy of
+// `ClaimedPlatform()`.
+inline std::string ClaimedMacGpuModel() {
+  if (platform_claim::Claimed() != "macos") {
+    return std::string();
+  }
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line || !command_line->HasSwitch(::switches::kFingerprint)) {
+    return std::string();
+  }
+  uint32_t fingerprint = 0;
+  base::StringToUint(command_line->GetSwitchValueASCII(::switches::kFingerprint),
+                     &fingerprint);
+  return fingerprint::kMacosGpuModels[fingerprint %
+                                      fingerprint::kMacosGpuModelCount];
+}
+
+// Does the claimed platform's Chromium report HEVC decode support? Consulted by
+// `supported_types.cc`, so it drives `canPlayType`, `MediaSource.isTypeSupported` and
+// `decodingInfo().supported` from one answer.
+inline bool ClaimedPlatformDecodesHevc() {
+  return platform_claim::ShouldPresentOtherPlatform("gpu") &&
+         platform_claim::Claimed() == "macos";
+}
+
+// Does the claimed platform decode this family in hardware? `false` means "no platform is claimed,
+// or Veil describes no hardware-decode set for it" and leaves the host's answer in place -- the five
+// families below are the only ones this patch speaks for, so VC-1, MPEG-2, Theora and Dolby Vision
+// keep the real answer rather than being over-claimed. On `true`, `*out` is what the claimed machine
+// reports as `powerEfficient` on the GPU branch of `decodingInfo()`.
+inline bool ClaimedHardwareDecode(VideoFamily family, bool* out) {
+  if (!platform_claim::ShouldPresentOtherPlatform("gpu") ||
+      platform_claim::Claimed() != "macos") {
+    return false;
+  }
+  switch (family) {
+    case VideoFamily::kH264:
+    case VideoFamily::kHEVC:
+      *out = true;
+      return true;
+    case VideoFamily::kVP8:
+    case VideoFamily::kVP9:
+      *out = false;
+      return true;
+    case VideoFamily::kAV1: {
+      const std::string model = ClaimedMacGpuModel();
+      *out = model.compare(0, 2, "M3") == 0 || model.compare(0, 2, "M4") == 0;
+      return true;
+    }
+  }
+  return false;
+}
+
+// The device kinds the claimed machine has, and the one entry to present for each. False leaves the
+// host's enumeration alone.
+//
+// **Absent kinds are added; present kinds are never replaced or trimmed.** That is the whole rule, and
+// it is the direction `963` clamps in and `967` refuses to raise in. Replacing a real microphone with
+// a described one would leave `getUserMedia()` unable to resolve any device, so a fingerprint browser
+// would stop being able to make a video call -- a Compatibility cost the fingerprint gain does not
+// justify. Adding a kind the host does not have costs nothing that worked: capture was already
+// impossible there. The tell this closes is the one that matters -- a machine reporting *no*
+// microphone and *no* camera is a server or a VM, which is what this build host is.
+//
+// The residual, recorded in 6.15: on a host that does have a microphone, its real label is still
+// exposed once the user grants a permission, and on a Mac persona that label names the wrong machine.
+// Closing it means replacing the device, which is the thing above.
+struct DeviceKinds {
+  bool audio_input = false;
+  bool video_input = false;
+  bool audio_output = false;
+};
+
+inline bool ClaimedDeviceKinds(DeviceKinds* out) {
+  if (!platform_claim::ShouldPresentOtherPlatform()) {
+    return false;
+  }
+  // A laptop, which is what every persona in this patch set claims: one built-in microphone, one
+  // built-in camera, one built-in output.
+  *out = DeviceKinds{true, true, true};
+  return true;
+}
+
+// Labels for the two kinds a device-less host is missing. They are only ever observable *after* the
+// user grants a capture permission -- pre-permission Chrome blanks every field and emits one entry per
+// kind (`media_devices_manager.cc:1199`) -- so they are named for the claimed machine rather than left
+// empty, which no real enumeration is.
+inline const char* ClaimedAudioInputLabel() {
+  return platform_claim::Claimed() == "macos" ? "MacBook Pro Microphone"
+                                              : "Built-in Microphone";
+}
+
+inline const char* ClaimedVideoInputLabel() {
+  return platform_claim::Claimed() == "macos" ? "FaceTime HD Camera"
+                                              : "Integrated Camera";
+}
+
+}  // namespace media_persona
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_MEDIA_PERSONA_H_

