# Origin:  adryfish/fingerprint-chromium
# Source:  patches/extra/fingerprint/016-webgl-readPixels.patch
# Commit:  831623f2965e34554304caabfc3a1e4e3741db1f (tag 144.0.7559.132)
# License: BSD-3-Clause (see CREDITS.md)
# Changes: regenerated against the post-series 151.0.7922.137 tree with 011 already applied. Only the
#          two include hunks needed it: 151 added base/byte_size.h, base/notimplemented.h and
#          base/trace_event/memory_dump_manager.h to the block, dropped base/containers/contains.h,
#          and reordered the components/ includes, so the context around both insertions was stale.
#          base/command_line.h and components/ungoogled/ungoogled_switches.h go in alphabetical
#          order, which for the second one is still immediately after build/build_config.h as the
#          144 patch has it. The static_bitmap_image.h include hunk and the ReadPixelsHelper hunk
#          applied unchanged (+14 and +215 offsets). Forward-applied to a pristine scratch copy
#          afterwards to confirm zero fuzz and zero offset.
#
#          It shares webgl_rendering_context_base.cc with 011-gpu-info and is sequenced after it, so
#          the include block it re-anchors against is the one 011 leaves behind.
#
# WebGL readPixels noise. After ContextGL()->ReadPixels() fills the caller's buffer,
# ReadPixelsHelper passes it through StaticBitmapImage::ShuffleSubchannelColorData with an SkImageInfo
# built from the requested GL format/type (RGBA/RGB/ALPHA 8-bit mapped explicitly, anything else
# assumed RGBA). Gated on --fingerprint=<seed>; --disable-spoofing=canvas opts out -- note it reads
# the canvas key, not a webgl one.
#
# Measured 2026-08-21, --fingerprint=7, against the 011 snapshot: webgl.readPixelsSha256
# 4aff75b8ea0e7f61 -> 0acd280c3620d39b, identical in the main frame, the cross-site iframe and the
# Worker, byte-identical on a repeat run, and 0c72ec1b33db9f79 for seed 8. Exactly three leaves moved
# and nothing else.
#
# Deterministic only because 012-canvas-get-image-data replaced bromite's random
# ShuffleSubchannelColorData body with a seed-derived one. On a tree with this patch but not 012 the
# readback would differ on every call.
#
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -32,6 +32,7 @@
 
 #include "base/bit_cast.h"
 #include "base/byte_size.h"
+#include "base/command_line.h"
 #include "base/compiler_specific.h"
 #include "base/feature_list.h"
 #include "base/memory/scoped_refptr.h"
@@ -45,6 +46,7 @@
 #include "base/trace_event/memory_dump_manager.h"
 #include "base/trace_event/trace_event.h"
 #include "build/build_config.h"
+#include "components/ungoogled/ungoogled_switches.h"
 #include "components/viz/common/gpu/raster_context_provider.h"
 #include "components/viz/common/resources/shared_image_format_utils.h"
 #include "device/vr/buildflags/buildflags.h"
@@ -150,6 +152,7 @@
 #include "third_party/blink/renderer/platform/graphics/paint/paint_record_builder.h"
 #include "third_party/blink/renderer/platform/graphics/skia/sk_image_info_hash.h"
 #include "third_party/blink/renderer/platform/graphics/skia/skia_utils.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
 #include "third_party/blink/renderer/platform/graphics/static_bitmap_image_transform.h"
 #include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
 #include "third_party/blink/renderer/platform/graphics/video_frame_image_util.h"
@@ -5358,6 +5361,33 @@
       return;
     }
     ContextGL()->ReadPixels(x, y, width, height, format, type, data);
+
+    // 添加指纹保护：修改已读取的像素数据
+    const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+    if (command_line->HasSwitch(switches::kFingerprint) &&
+        (!command_line->HasSwitch(switches::kDisableSpoofing) ||
+         command_line->GetSwitchValueASCII(switches::kDisableSpoofing).find("canvas") == std::string::npos)) {
+      // 构建 SkImageInfo 来描述像素格式
+      SkColorType color_type;
+      SkAlphaType alpha_type = kUnpremul_SkAlphaType;
+
+      // 根据 WebGL 格式映射到 Skia 格式
+      if (format == GL_RGBA && type == GL_UNSIGNED_BYTE) {
+        color_type = kRGBA_8888_SkColorType;
+      } else if (format == GL_RGB && type == GL_UNSIGNED_BYTE) {
+        color_type = kRGB_888x_SkColorType;
+      } else if (format == GL_ALPHA && type == GL_UNSIGNED_BYTE) {
+        color_type = kAlpha_8_SkColorType;
+      } else {
+        // 对于其他格式，假设为 RGBA
+        color_type = kRGBA_8888_SkColorType;
+      }
+
+      SkImageInfo image_info = SkImageInfo::Make(width, height, color_type, alpha_type);
+
+      // 调用指纹保护函数修改已读取的像素数据
+      StaticBitmapImage::ShuffleSubchannelColorData(data, image_info, 0, 0);
+    }
   }
 }
 
