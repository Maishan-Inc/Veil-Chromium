# Origin:  adryfish/fingerprint-chromium
# Source:  patches/extra/fingerprint/015-canvas-measure-text.patch
# Commit:  831623f2965e34554304caabfc3a1e4e3741db1f (tag 144.0.7559.132)
# License: BSD-3-Clause (see CREDITS.md)
# Changes: none -- ported verbatim. Applies with zero fuzz to the post-series 151.0.7922.137 tree
#          once 012-canvas-get-image-data is in place: 012 is what converts the measureText gate
#          from RuntimeEnabledFeatures::FingerprintingCanvasMeasureTextNoiseEnabled() to
#          --fingerprint=<seed>, and this patch's only hunk opens on that guard. The single offset
#          (-21 lines) is a line-number shift patch resolves silently, not dropped context.
#
# Makes the canvas measureText perturbation seed-derived: hash("<seed>clientrects_noise_x") mapped
# to [-0.5, 0.5] and scaled by 1e-5, in place of Document::GetNoiseFactorX(). Also stops
# perturbing empty strings.
#
# ---------------------------------------------------------------------------------------------
# MEASURED 2026-08-21, AND IT DOES NOT DO WHAT ITS NAME SAYS. Do not enable this in a shipped
# engine as it stands. Two independent defects, both in the upstream patch, both reproduced here:
#
# 1. TextMetrics::Shuffle(factor) MULTIPLIES every metric by factor. The value this patch passes is
#    the noise itself, in +/-5e-6, not 1 +/- noise. With --fingerprint=7 the factor is 6.098e-7 and
#    measureText("Cwm fjordbank glyphs vext quiz -- 0123456789").width goes 567.4482421875 ->
#    0.000346040074084674. Every non-zero metric collapses by the same factor. That is not noise; it
#    breaks the API for any page that lays out text from canvas measurements, and a width of 3e-4 is
#    a louder tell than the true value. The value it replaces -- Document::GetNoiseFactorX() -- is
#    ~1 +/- 1.5e-6, i.e. multiplicative, which is where the mismatch comes from. The companion
#    patch 014-client-rects computes the same quantity and uses it ADDITIVELY (rect.Offset), so the
#    likely upstream slip is a copy of 014's arithmetic into a multiplicative call site.
#
# 2. The Worker realm is left unspoofed. An OffscreenCanvas in a Worker takes the
#    HostAsOffscreenCanvas() branch, which requires a LocalDOMWindow that a Worker does not have, so
#    Shuffle is never called there. Measured: main frame 0.000346, Worker 567.4482421875 -- eight
#    divergent leaves, and the cross-realm assertion fails. A value that differs between the main
#    frame and a Worker is the single most reliable way a spoof reveals itself.
#
# Kept as a faithful port because Stage 5's job is to port and measure, not to redesign: a
# Veil-authored deviation is a Tier 2 decision with its own commit and justification. The fix is
# Shuffle(1.0 + noise_x) plus a Worker path that does not need a window. Recorded in
# Veil/docs/MIGRATION-UNGOOGLED.md 5.1h, and a blocker on 5.5.
# ---------------------------------------------------------------------------------------------
#
diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
index e366476291..af2d2c832c 100644
--- a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
@@ -1191,13 +1191,21 @@ TextMetrics* BaseRenderingContext2D::measureText(const String& text) {
   if (command_line->HasSwitch(switches::kFingerprint) &&
       (!command_line->HasSwitch(switches::kDisableSpoofing) ||
        command_line->GetSwitchValueASCII(switches::kDisableSpoofing).find("canvas") == std::string::npos)) {
+    std::string seed_str = command_line->GetSwitchValueASCII(switches::kFingerprint);
+    std::string combined_rects_x = seed_str + "clientrects_noise_x";
+    uint32_t hash_val_x = std::hash<std::string>{}(combined_rects_x);
+     // 映射到[-0.5, 0.5]范围
+    double norm_x = (hash_val_x & 0xFFFFFFFF) / 4294967295.0 - 0.5;
+    // 使用 0.00001 作为因子 (相当于原来的 1/100000.0)
+    double noise_x = norm_x * 0.00001;
     if (HostAsOffscreenCanvas()) {
       if (auto* window = DynamicTo<LocalDOMWindow>(GetTopExecutionContext())) {
-        if (window->GetFrame() && window->GetFrame()->GetDocument())
-          text_metrics->Shuffle(window->GetFrame()->GetDocument()->GetNoiseFactorX());
+        if (window->GetFrame() && window->GetFrame()->GetDocument() && text.length() > 0) {
+          text_metrics->Shuffle(noise_x);
+        }
       }
-    } else if (canvas) {
-      text_metrics->Shuffle(canvas->GetDocument().GetNoiseFactorX());
+    } else if (canvas && text.length() > 0) {
+      text_metrics->Shuffle(noise_x);
     }
   }
   return text_metrics;
