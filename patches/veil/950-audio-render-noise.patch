 namespace blink {
 
+namespace {
+
+// Seed-derived perturbation of the rendered offline buffer, applied to the frames of one render
+// quantum before they are copied out. Veil-authored; it replaces the sample-rate perturbation
+// 003-audio-fingerprint used, which was both quantised away for about a seed in five and illegal --
+// an OfflineAudioContext must report the sample rate the page asked for. See the patch header.
+//
+// Keyed on the seed, the channel and the ABSOLUTE frame index, so the result depends on neither the
+// render quantum boundaries nor a suspend/resume, and is identical in every realm and every run.
+void PerturbRenderedAudio(AudioBus* bus,
+                          size_t first_frame,
+                          uint32_t frame_count) {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint)) {
+    return;
+  }
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing).find("audio") !=
+          std::string::npos) {
+    return;
+  }
+  const std::string seed_str = command_line->GetSwitchValueASCII(switches::kFingerprint);
+  if (seed_str.empty()) {
+    return;
+  }
+  const uint32_t seed = static_cast<uint32_t>(std::hash<std::string>{}(seed_str + "audio"));
+
+  for (unsigned channel_index = 0; channel_index < bus->NumberOfChannels(); ++channel_index) {
+    AudioChannel* channel = bus->Channel(channel_index);
+    // Silence stays exactly silent: a multiplicative factor leaves 0 at 0, and skipping the
+    // channel also leaves AudioChannel's silent flag alone rather than clearing it.
+    if (!channel || channel->IsSilent()) {
+      continue;
+    }
+    base::span<float> samples = channel->MutableSpan();
+    const uint32_t limit = std::min(frame_count, static_cast<uint32_t>(samples.size()));
+    for (uint32_t i = 0; i < limit; ++i) {
+      uint32_t x = seed ^ (channel_index * 2654435761u) ^
+                   (static_cast<uint32_t>(first_frame + i) * 2246822519u);
+      x ^= x << 13;
+      x ^= x >> 17;
+      x ^= x << 5;
+      // Relative, so every non-zero sample moves by more than a float ULP: the relative ULP is
+      // 2^-24 ~= 6e-8 and the factor is uniform in +/-1e-4. -80 dB, inaudible.
+      const float noise = (static_cast<float>(x) / 4294967295.0f - 0.5f) * 2e-4f;
+      samples[i] *= (1.0f + noise);
+    }
+  }
+}
+
+}  // namespace
