+// Veil 906: does the claimed platform present this family? Blink aliases Arial <-> Helvetica,
+// Times <-> Times New Roman and Courier <-> Courier New on every platform
+// (AlternateFamilyName(), read by FontPlatformDataCache), so a machine whose Arial resolves
+// reports Helvetica present as well. The alias is checked here for that reason: without it a
+// Windows persona would report Helvetica absent, which no Chrome on Windows does.
+static bool VeilPlatformPresentsFamily(const std::vector<std::string>& platform_fonts,
+                                       const std::string& font_family) {
+  if (std::find(platform_fonts.begin(), platform_fonts.end(), font_family) !=
+      platform_fonts.end()) {
+    return true;
+  }
+  const AtomicString& alternate = AlternateFamilyName(AtomicString(font_family.c_str()));
+  return !alternate.empty() &&
+         std::find(platform_fonts.begin(), platform_fonts.end(), alternate.Utf8()) !=
+             platform_fonts.end();
+}
+
+// Veil 906: is this family listed in a platform table other than the claimed one? Used only by
+// the same-OS branch, where the family list is the host's own and the one contradiction it can
+// still carry is a face from another operating system -- a Windows machine with "Lucida Grande"
+// or "Menlo" installed by some application reports two OSes at once, which is exactly what
+// assertion 6's font-set-belongs-to-one-os scores.
+//
+// The three tables are built once. 006 calls GetPlatformFonts() twice per font lookup and each
+// call materialises up to 541 std::strings from a braced list; scanning two more tables per
+// lookup would be the same cost again, and none of the three ever changes.
+static bool VeilFamilyBelongsToAnotherPlatform(const std::string& platform,
+                                               const std::string& font_family) {
+  static const std::vector<std::string> kWindowsFonts = GetPlatformFonts("windows");
+  static const std::vector<std::string> kMacFonts = GetPlatformFonts("macos");
+  static const std::vector<std::string> kLinuxFonts = GetPlatformFonts("linux");
+  const std::pair<const char*, const std::vector<std::string>*> kTables[] = {
+      {"windows", &kWindowsFonts}, {"macos", &kMacFonts}, {"linux", &kLinuxFonts}};
+
+  for (const auto& [name, table] : kTables) {
+    if (platform != name && VeilPlatformPresentsFamily(*table, font_family)) {
+      return true;
+    }
+  }
+  return false;
 }
 
 
