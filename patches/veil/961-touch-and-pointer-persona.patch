diff --git a/components/ungoogled/input_persona.h b/components/ungoogled/input_persona.h
new file mode 100644
index 0000000000..ce0b9eaa8c
--- /dev/null
+++ b/components/ungoogled/input_persona.h
@@ -0,0 +1,117 @@
+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// How many touch points does the claimed machine have, and does the user get to say?
+//
+// `navigator.maxTouchPoints`, `(pointer:)`, `(any-pointer:)`, `(hover:)` and `(any-hover:)` are five
+// reads of **one** browser-side answer: `SlowWebPreferenceCache::Update()` fills six
+// `WebPreferences` fields from `ui::MaxTouchPoints()` and `ui::GetAvailablePointerAndHoverTypes()`,
+// and `SlowWebPreferenceCache::Load()` copies all six into every renderer's prefs. That is why this
+// patch overrides `Load()` and not `NavigatorEvents::maxTouchPoints`: moving the count alone would
+// trade one contradiction for another, since a machine reporting 0 touch points while
+// `(any-pointer: coarse)` still matches is not a machine.
+//
+// Measured on this host, on both binaries and on stock Chrome 151 in the same minute: 10 touch
+// points, `(any-pointer: coarse)` **and** `(any-pointer: fine)`, `(hover: hover)`. The `persona`
+// case claims macOS, so all three are the loudest remaining contradiction assertion 6 scores
+// (`Veil/docs/MIGRATION-UNGOOGLED.md` -> 6.17).
+//
+// THE PLATFORM TABLE, and the two rows are not the same kind of claim.
+//
+// - **macOS: 0, structurally.** `ui/base/BUILD.gn:434-445` builds `pointer_device_win.cc` for
+//   Windows, `_android`, `_ios`, `_linux` and `_web_engine` for theirs, and
+//   `pointer/pointer_device_default.cc` for everything else -- macOS included. That file is 25 lines
+//   of constants: `MaxTouchPoints()` returns 0, `GetAvailablePointerAndHoverTypesImpl()` returns
+//   `{POINTER_TYPE_FINE, HOVER_TYPE_HOVER}`, `GetTouchScreensAvailability()` returns `NONE`
+//   (`ui/base/pointer/pointer_device_default.cc:13-24`). No Mac can report a touchscreen through
+//   this API even if Apple ships one, so this is a statement about what Chromium *builds* per
+//   platform -- the same class of claim as the identity strings, never a hardware spec sheet.
+// - **Linux: 0, modally.** `pointer_device_linux.cc:33-40` answers from `DeviceDataManager`'s
+//   touchscreen list, so the platform does not decide and a Linux touch laptop is real. 0 is chosen
+//   because the alternative is *this Windows host's* digitizer count, which is a leak rather than a
+//   guess, and the switch below is how a user says otherwise. The header says "modally" out loud so
+//   the next reader does not mistake it for the macOS row.
+// - **Windows: no override.** The claim is this build's own platform, so the host's real
+//   configuration is already a plausible Windows machine and substituting Veil's idea of one can
+//   only replace a true value with a guess. `906`'s same-OS argument, third application.
+//
+// THE SWITCH. `--fingerprint-max-touch-points=<n>` is the one switch phase 4's input block takes,
+// and it is taken because the platform genuinely does not carry the answer: a Windows or Linux
+// persona may or may not have a touchscreen, and no other field Veil sends implies it. Honoured
+// **with or without a seed and on any claim**, which is `--fingerprint-hardware-concurrency`'s
+// shape: a value the user typed is not a cross-platform substitution, so it is not gated on one.
+//
+// Declared in `ungoogled_switches` and read **here, in the browser process, only**. It is
+// deliberately *not* added to `PropagateBrowserCommandLineToRenderer`'s allow-list: no renderer code
+// reads it, and a switch propagated into a process that never reads it is the fourth instance of the
+// mirror violation `000` already carries four of -- declared, propagated, read by nothing (6.9).
+
+#ifndef COMPONENTS_UNGOOGLED_INPUT_PERSONA_H_
+#define COMPONENTS_UNGOOGLED_INPUT_PERSONA_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/ungoogled/platform_claim.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+namespace ungoogled {
+namespace input_persona {
+
+// The count `--fingerprint-max-touch-points=<n>` asks for, if it is present and parses. A negative
+// value is rejected rather than clamped: `WebPreferences::pointer_events_max_touch_points` is an
+// `int` that reaches `Settings::SetMaxTouchPoints`, and a caller who typed one meant something this
+// code cannot guess.
+inline std::optional<int> RequestedTouchPoints() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line ||
+      !command_line->HasSwitch(::switches::kFingerprintMaxTouchPoints)) {
+    return std::nullopt;
+  }
+  int requested = 0;
+  if (!base::StringToInt(command_line->GetSwitchValueASCII(
+                             ::switches::kFingerprintMaxTouchPoints),
+                         &requested) ||
+      requested < 0) {
+    return std::nullopt;
+  }
+  return requested;
+}
+
+// The count the claimed platform implies, for a claim that is not this build's own. `std::nullopt`
+// means "this platform does not decide, leave the host's" -- which is every Windows claim, because a
+// Windows claim on a Windows host is the same-OS case.
+inline std::optional<int> TouchPointsForClaim(std::string_view claimed) {
+  if (claimed == "macos" || claimed == "linux") {
+    return 0;
+  }
+  return std::nullopt;
+}
+
+// The one answer the six prefs are derived from. Switch, then the claimed platform, then nothing.
+//
+// The platform rung is gated on `ShouldPresentOtherPlatform()`, so a seedless launch and a same-OS
+// claim both fall through to the host untouched. The switch rung is not gated at all.
+//
+// `--disable-spoofing` has no key for this surface and deliberately gains none: Veil has no field
+// that could emit one, and a switch value nothing can send is the same lie as a switch no Chromium
+// has (CLAUDE.md, "Flag dialect"). The `--fingerprint-max-touch-points` field is the opt-out --
+// leaving it unset is how a profile keeps the host's input configuration.
+inline std::optional<int> EffectiveTouchPoints() {
+  if (std::optional<int> requested = RequestedTouchPoints()) {
+    return requested;
+  }
+  if (!platform_claim::ShouldPresentOtherPlatform()) {
+    return std::nullopt;
+  }
+  return TouchPointsForClaim(platform_claim::Claimed());
+}
+
+}  // namespace input_persona
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_INPUT_PERSONA_H_

