+// Veil `961`: the five input prefs a persona owns, answered from one touch-point count.
+//
+// `Update()` above fills them from `ui::MaxTouchPoints()` and
+// `ui::GetAvailablePointerAndHoverTypes()`, which are the *host's* devices. Five web surfaces read
+// the result -- `navigator.maxTouchPoints`, `(pointer:)`, `(any-pointer:)`, `(hover:)` and
+// `(any-hover:)` -- so overriding the count without the pointer types would trade one contradiction
+// for another: 0 touch points beside a matching `(any-pointer: coarse)` is not a machine. This is
+// the single place all five are written, which is why it is the hook.
+//
+// Where the count comes from, and why 0 is the macOS answer, is
+// components/ungoogled/input_persona.h. Here is only the mapping from a count to the four pointer
+// and hover fields, and each line is Chromium's own derivation rather than a choice:
+//
+//   ui/base/pointer/pointer_device_default.cc:13-15  the no-touch pair is {FINE, HOVER}, and that
+//                                                    file is what macOS builds
+//   ui/base/pointer/pointer_device_win.cc:50-68      a touchscreen *adds* COARSE next to FINE; the
+//   ui/base/pointer/pointer_device_linux.cc:33-40    pointing device does not go away
+//   ui/base/pointer/pointer_device.cc:47-66          FINE wins the primary slot whenever present,
+//                                                    and HOVER likewise -- both are derived
+//
+// `touch_event_feature_detection_enabled` is deliberately **not** touched. It is `false` on every
+// desktop build regardless of hardware: `Update()` defaults the switch to
+// `kTouchEventFeatureDetectionDisabled` off Android and iOS, so `ontouchstart` is absent on this
+// 10-touch-point host exactly as it is on a Mac (measured on stock Chrome 151 in the same minute).
+// A pref that already agrees with the claim is not this patch's business.
+void ApplyInputPersona(blink::web_pref::WebPreferences* prefs) {
+  const std::optional<int> touch_points =
+      ungoogled::input_persona::EffectiveTouchPoints();
+  if (!touch_points.has_value()) {
+    return;
+  }
+  const bool has_touch = *touch_points > 0;
+  prefs->pointer_events_max_touch_points = *touch_points;
+  prefs->available_pointer_types =
+      has_touch ? (ui::POINTER_TYPE_COARSE | ui::POINTER_TYPE_FINE)
+                : ui::POINTER_TYPE_FINE;
+  prefs->primary_pointer_type = blink::mojom::PointerType::kPointerFineType;
+  prefs->available_hover_types = ui::HOVER_TYPE_HOVER;
+  prefs->primary_hover_type = blink::mojom::HoverType::kHoverHoverType;
+}
 }  // namespace
 
