+// The WebGL capability set the claimed GPU implies -- the other half of `011`.
+//
+// `011` answers UNMASKED_RENDERER_WEBGL from a table indexed by `--fingerprint` and
+// `--fingerprint-platform`, and leaves every number beside it at the host's value. Measured: a build
+// claiming an Apple M3 still reported the real card's 32767x32767 viewport, its 65536-byte uniform
+// blocks and its 4095 vertex uniform vectors (Veil/docs/MIGRATION-UNGOOGLED.md 5.1n). Cross-checking a
+// claimed model against its limits is a standard check, so the name on its own was worth little and in
+// some scoring models less than nothing. This header is the capability half, and it follows the same
+// platform claim the name follows -- no switch of its own, because a `--fingerprint-gpu-*` beside
+// `011`'s table would be a second source for one fact (6.9).
+//
+// Three rules, and they are the difference between this and a table of numbers.
+//
+// (1) DOWNWARD ONLY. A limit is never reported above what the live driver reports, because an upward
+//     claim is falsifiable in one line: the page allocates the texture, links the shader, binds the
+//     uniform block, and watches it fail. A *lower* limit is a legal GL implementation on any
+//     hardware, so under-claiming is at worst a passive mismatch against a spec sheet the page has to
+//     have brought with it. The trade is deliberate: a passive mismatch beats an active refutation.
+//
+// (2) ALIGNMENTS UPWARD. UNIFORM_BUFFER_OFFSET_ALIGNMENT is not a capability, it is a constraint on
+//     the page's own calls. Reporting 16 where the driver enforces 256 makes
+//     `bindBufferRange(..., 16, ...)` fail on an offset the page was just told was legal. So this one
+//     is max(claimed, real): never finer than the driver enforces.
+//
+// (3) DERIVE, DO NOT STORE. ANGLE computes nine of these numbers from the others, by the same
+//     arithmetic on both backends: components are 4x vectors, the combined block count is the sum of
+//     the two stage counts, and a combined component count is blocks * (blockSize / 4) + components.
+//     A page can redo that arithmetic in one line. Storing a spoofed value for a derived limit is a
+//     self-contradiction that rule (1) makes *more* likely rather than less: clamp two independents by
+//     different amounts and a stored dependent matches neither. So every dependent is computed here,
+//     after the clamp, from the clamped independents, and the relations hold by construction.
+//
+// Where the numbers come from. Not a corpus and not a vendor PDF: ANGLE's own backends, in this tree,
+// which is the code that runs on the machine being claimed. Each field carries its site.
+//
+//   windows -> third_party/angle/src/libANGLE/renderer/d3d/d3d11/renderer11_utils.cpp
+//   macos   -> third_party/angle/src/libANGLE/renderer/metal/DisplayMtl.mm + mtl_common.h
+//
+// The windows table is also the one number set this host can check: it is a D3D11/NVIDIA machine, so
+// every windows value below must come back bit-identical to the unpatched capture. That is this
+// patch's control, and it is why the table is a transcription rather than a preference.
+//
+// Not covered, and recorded rather than guessed:
+//
+//   - MAX_SAMPLES. D3D11 defers it to per-format sample counts (renderer11_utils.cpp:1268) and Metal
+//     probes `supportsTextureSampleCount:` over {2,4,8} (mtl_format_utils.mm:105). Both are runtime
+//     device queries, so the Apple value is not derivable in this tree. Left at the host's.
+//   - The compressed-texture extension families. `[MTLDevice supportsBCTextureCompression]` decides
+//     whether a Mac has S3TC/RGTC/BPTC at all (mtl_format_table_autogen.mm:4114) -- another runtime
+//     query -- and ASTC/ETC/PVRTC, which every Apple GPU has and no D3D11 host does, can only be
+//     *added*, which `getExtension()` would refute in the same line. Only `OVR_multiview2` is settled
+//     in-tree: three backends set it and the Metal backend never does.
+//   - RED_/GREEN_/BLUE_/ALPHA_/DEPTH_/STENCIL_BITS, SAMPLES, SAMPLE_BUFFERS. These describe the
+//     drawing buffer Chromium allocated for the attributes the page asked for, not the device.
+//   - Linux. ANGLE's GL backend passes the driver's own limits through, so there is no fixed table to
+//     transcribe. A `--fingerprint-platform=linux` persona keeps the host's numbers, which is the
+//     pre-existing state `011` left; the caps here are inert rather than wrong.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_VEIL_WEBGL_CAPS_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_VEIL_WEBGL_CAPS_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_util.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "gpu/command_buffer/client/gles2_interface.h"
+
+namespace blink {
+namespace veil_webgl_caps {
+
+// One resolved answer for every WebGL limit this patch reports. `active` is false whenever the
+// claim does not apply -- no seed, GPU spoofing opted out, or a platform with no table -- and every
+// call site is written so that `!active` means "do exactly what stock Chromium did".
+//
+// The first block is what a backend fixes; the second is computed from the first by Resolve() and is
+// never written by a table. `int64_t` on the two combined component counts because GL reports them
+// through GetInteger64v and the D3D11 values overflow nothing but read as int64 in ANGLE too.
+struct Caps {
+  bool active = false;
+
+  // Fixed by the claimed backend.
+  int32_t texture_size = 0;
+  int32_t cube_map_texture_size = 0;
+  int32_t renderbuffer_size = 0;
+  int32_t viewport_dim = 0;
+  int32_t texture_3d_size = 0;
+  int32_t array_texture_layers = 0;
+  int32_t vertex_attribs = 0;
+  int32_t vertex_texture_units = 0;
+  int32_t fragment_texture_units = 0;
+  int32_t vertex_uniform_vectors = 0;
+  int32_t fragment_uniform_vectors = 0;
+  int32_t vertex_uniform_blocks = 0;
+  int32_t fragment_uniform_blocks = 0;
+  int32_t uniform_block_size = 0;
+  int32_t varying_vectors = 0;
+  int32_t draw_buffers = 0;
+  int32_t color_attachments = 0;
+  int32_t uniform_buffer_offset_alignment = 0;
+  float texture_lod_bias = 0.f;
+  float aliased_point_size_min = 0.f;
+  float aliased_point_size_max = 0.f;
+  float aliased_line_width_min = 0.f;
+  float aliased_line_width_max = 0.f;
+
+  // Derived from the block above, after the clamp. Rule (3).
+  int32_t combined_texture_image_units = 0;
+  int32_t vertex_uniform_components = 0;
+  int32_t fragment_uniform_components = 0;
+  int32_t varying_components = 0;
+  int32_t combined_uniform_blocks = 0;
+  int32_t uniform_buffer_bindings = 0;
+  int64_t combined_vertex_uniform_components = 0;
+  int64_t combined_fragment_uniform_components = 0;
+};
+
+// ANGLE's D3D11 backend at feature level 11_0, which is what `011`'s Windows table claims: every
+// entry in it is an NVIDIA card, and NVIDIA is the one vendor for which ANGLE subtracts a vertex
+// constant register.
+//
+//   texture / cube / renderbuffer  GetMaximum{2DTextureSize,CubeMapTextureSize} -- D3D11_REQ_TEXTURE2D
+//   viewport_dim                   GetMaximumViewportSize -> D3D11_VIEWPORT_BOUNDS_MAX (:425)
+//   texture_3d_size                D3D11_REQ_TEXTURE3D_U_V_OR_W_DIMENSION
+//   array_texture_layers           D3D11_REQ_TEXTURE2D_ARRAY_AXIS_DIMENSION
+//   vertex_attribs                 clamped by the front end to gl::MAX_VERTEX_ATTRIBS
+//   *_texture_units                D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT (:612)
+//   vertex_uniform_vectors         D3D11_REQ_CONSTANT_BUFFER_ELEMENT_COUNT (4096) minus 1 for
+//                                  features.skipVSConstantRegisterZero, which is `isNvidia` (:2183)
+//   fragment_uniform_vectors       GetMaximumPixelUniformVectors -- hard-coded 1024 (:632)
+//   *_uniform_blocks               API_SLOT_COUNT 14 minus RESERVED 2 (:536)
+//   uniform_block_size             GetMaximumConstantBufferSize -- 4096 elements x 16 B (:852)
+//   varying_vectors                D3D11_VS_OUTPUT_REGISTER_COUNT 32 minus 2 reserved (:588)
+//   draw_buffers / color_attach.   GetMaximumSimultaneousRenderTargets
+//   texture_lod_bias               "Unimplemented, set to minimum required" -- 2.0 (:1144)
+//   aliased point / line           1024 and 1.0, both hard-coded (:1160)
+//   uniform_buffer_offset_align.   256, the DirectX 11.1 constant-buffer rule (:1241)
+inline constexpr Caps kWindowsD3D11 = {
+    .active = true,
+    .texture_size = 16384,
+    .cube_map_texture_size = 16384,
+    .renderbuffer_size = 16384,
+    .viewport_dim = 32767,
+    .texture_3d_size = 2048,
+    .array_texture_layers = 2048,
+    .vertex_attribs = 16,
+    .vertex_texture_units = 16,
+    .fragment_texture_units = 16,
+    .vertex_uniform_vectors = 4095,
+    .fragment_uniform_vectors = 1024,
+    .vertex_uniform_blocks = 12,
+    .fragment_uniform_blocks = 12,
+    .uniform_block_size = 65536,
+    .varying_vectors = 30,
+    .draw_buffers = 8,
+    .color_attachments = 8,
+    .uniform_buffer_offset_alignment = 256,
+    .texture_lod_bias = 2.f,
+    .aliased_point_size_min = 1.f,
+    .aliased_point_size_max = 1024.f,
+    .aliased_line_width_min = 1.f,
+    .aliased_line_width_max = 1.f,
+};
+
+// ANGLE's Metal backend on macOS, which is what `011`'s macOS table claims -- every entry there is an
+// Apple M-series part, so the TARGET_OS_OSX branch is the whole story and no Intel-Mac variant is
+// needed. Line numbers are DisplayMtl.mm unless marked.
+//
+//   texture / cube / renderbuffer  max2DTextureSize 16384 on macOS (:731), cube and renderbuffer are
+//                                  assigned from it (:756-757)
+//   viewport_dim                   maxViewportWidth = max2DTextureSize (:782) -- 16384, not D3D11's
+//                                  32767, and the one limit that says "Metal" on its own
+//   texture_3d_size                2048 (:729)
+//   array_texture_layers           2048 (:754)
+//   vertex_attribs                 mtl::kMaxVertexAttribs = gl::MAX_VERTEX_ATTRIBS (mtl_common.h:89)
+//   *_texture_units                mtl::kMaxShaderSamplers 16 (mtl_common.h:116)
+//   *_uniform_vectors              kDefaultUniformsMaxSize 16 KiB / 16 B per vec4 = 1024
+//                                  (mtl_common.h:118, DisplayMtl.mm:834)
+//   *_uniform_blocks               mtl::kMaxShaderUBOs 16 (mtl_common.h:102)
+//   uniform_block_size             mtl::kMaxUBOSize 16384 (mtl_common.h:103)
+//   varying_vectors                31 - 1 on macOS, where [[position]] is excluded (:733)
+//   draw_buffers / color_attach.   mtl::kMaxRenderTargets 8, taken on any Apple GPU (:769)
+//   texture_lod_bias               log2(max2DTextureSize) + 1 = 15 (:755) -- D3D11 reports 2
+//   aliased point / line           511 and 1.0 (:763-765)
+//   uniform_buffer_offset_align.   16 on Apple-family GPUs, 256 elsewhere (:869) -- rule (2) applies
+inline constexpr Caps kMacOSMetal = {
+    .active = true,
+    .texture_size = 16384,
+    .cube_map_texture_size = 16384,
+    .renderbuffer_size = 16384,
+    .viewport_dim = 16384,
+    .texture_3d_size = 2048,
+    .array_texture_layers = 2048,
+    .vertex_attribs = 16,
+    .vertex_texture_units = 16,
+    .fragment_texture_units = 16,
+    .vertex_uniform_vectors = 1024,
+    .fragment_uniform_vectors = 1024,
+    .vertex_uniform_blocks = 16,
+    .fragment_uniform_blocks = 16,
+    .uniform_block_size = 16384,
+    .varying_vectors = 30,
+    .draw_buffers = 8,
+    .color_attachments = 8,
+    .uniform_buffer_offset_alignment = 16,
+    .texture_lod_bias = 15.f,
+    .aliased_point_size_min = 1.f,
+    .aliased_point_size_max = 511.f,
+    .aliased_line_width_min = 1.f,
+    .aliased_line_width_max = 1.f,
+};
+
+// The same gate `011` applies, spelled the same way. A seed is required, and
+// `--disable-spoofing=gpu` opts out of the whole GPU story: the name and the capabilities go together,
+// because opting out of one and not the other is a contradiction the user has no way to see.
+inline bool Enabled() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line) {
+    return false;
+  }
+  if (command_line->HasSwitch(::switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(::switches::kDisableSpoofing)
+              .find("gpu") != std::string::npos) {
+    return false;
+  }
+  return command_line->HasSwitch(::switches::kFingerprint);
+}
+
+// The claimed platform, lower-cased, or the empty string. Read exactly as `002`, `006`, `011` and
+// `960` read it.
+inline std::string ClaimedPlatform() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line && command_line->HasSwitch(::switches::kFingerprintPlatform)) {
+    return base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(::switches::kFingerprintPlatform));
+  }
+  return std::string();
+}
+
+// The table the claim selects, before any clamping.
+//
+// An absent platform falls to the D3D11 table rather than to nothing, because that is where `011`
+// falls: `GetGLRendererStringForFingerprint()` defaults `platform` to "windows", so a seed with no
+// `--fingerprint-platform` already claims an NVIDIA card and the capabilities have to agree with the
+// name that is being reported. `linux`, `android` and `ios` return an inactive set -- there is no
+// fixed table to transcribe for ANGLE's GL backend, and a guess would be worse than the host's truth.
+inline Caps Claimed() {
+  if (!Enabled()) {
+    return Caps();
+  }
+  const std::string platform = ClaimedPlatform();
+  if (platform == "macos") {
+    return kMacOSMetal;
+  }
+  if (platform.empty() || platform == "windows") {
+    return kWindowsD3D11;
+  }
+  return Caps();
+}
+
+// Rule (1). The live driver value wins whenever the claim is larger. Reading it costs nothing a
+// getParameter did not already cost: every pname below is answered from GLES2Implementation's
+// client-side `gl_capabilities_` without a round trip (gles2_implementation.cc:925-1200).
+inline int32_t ClampDown(gpu::gles2::GLES2Interface* gl, GLenum pname, int32_t want) {
+  GLint real = 0;
+  gl->GetIntegerv(pname, &real);
+  return (real > 0 && want > real) ? static_cast<int32_t>(real) : want;
+}
+
+inline float ClampDownF(gpu::gles2::GLES2Interface* gl, GLenum pname, float want) {
+  GLfloat real = 0.f;
+  gl->GetFloatv(pname, &real);
+  return (real > 0.f && want > real) ? static_cast<float>(real) : want;
+}
+
+// GL_MAX_VIEWPORT_DIMS writes two ints, so it needs its own reader: handing GetIntegerv a single
+// GLint* smashes the stack. Veil claims one square limit, as both backends report.
+inline int32_t ClampDownViewport(gpu::gles2::GLES2Interface* gl, int32_t want) {
+  GLint real[2] = {0, 0};
+  gl->GetIntegerv(GL_MAX_VIEWPORT_DIMS, real);
+  const GLint cap = real[0] < real[1] ? real[0] : real[1];
+  return (cap > 0 && want > cap) ? static_cast<int32_t>(cap) : want;
+}
+
+// GL_ALIASED_POINT_SIZE_RANGE and GL_ALIASED_LINE_WIDTH_RANGE write two floats each, so they need the
+// same treatment GL_MAX_VIEWPORT_DIMS does. Only the upper end is clamped: both backends report a
+// minimum of exactly 1.0, and a *smaller* minimum would be a claim to draw finer points than the
+// driver can.
+inline float ClampDownRangeMaxF(gpu::gles2::GLES2Interface* gl,
+                                GLenum pname,
+                                float want) {
+  GLfloat real[2] = {0.f, 0.f};
+  gl->GetFloatv(pname, real);
+  return (real[1] > 0.f && want > real[1]) ? static_cast<float>(real[1]) : want;
+}
+
+// Rule (2). A coarser alignment than the claim is still legal for the page; a finer one is not.
+inline int32_t ClampUp(gpu::gles2::GLES2Interface* gl, GLenum pname, int32_t want) {
+  GLint real = 0;
+  gl->GetIntegerv(pname, &real);
+  return (real > want) ? static_cast<int32_t>(real) : want;
+}
+
+// The claim, clamped against this driver, with every dependent recomputed from the clamped
+// independents. Rule (3): the derived block is written here and nowhere else, so no table can put a
+// stored dependent out of step with the values it is supposed to follow from.
+//
+// `es3` says whether the caller's context can answer ES3 queries, and it is not a convenience.
+// GLES2Implementation::GetHelper() returns early for every ES3 pname when the context is ES2
+// (gles2_implementation.cc:1114), so reading one on a WebGL1 context falls through to the service and
+// raises GL_INVALID_ENUM -- a getError() a page can see, on a call stock Chromium makes silently. The
+// WebGL1 getParameter arms pass false and report only the ES2 block; the WebGL2 arms pass true. When
+// it is false the ES3 independents keep their table values unclamped, which is harmless precisely
+// because that path never reports them.
+//
+// Cheap enough to call per getParameter -- see ClampDown -- so there is no cached copy of this on the
+// context and therefore no second answer that could go stale across a context loss.
+inline Caps Resolve(gpu::gles2::GLES2Interface* gl, bool es3) {
+  Caps caps = Claimed();
+  if (!caps.active || !gl) {
+    return Caps();
+  }
+
+  caps.texture_size = ClampDown(gl, GL_MAX_TEXTURE_SIZE, caps.texture_size);
+  caps.cube_map_texture_size =
+      ClampDown(gl, GL_MAX_CUBE_MAP_TEXTURE_SIZE, caps.cube_map_texture_size);
+  caps.renderbuffer_size =
+      ClampDown(gl, GL_MAX_RENDERBUFFER_SIZE, caps.renderbuffer_size);
+  caps.viewport_dim = ClampDownViewport(gl, caps.viewport_dim);
+  caps.vertex_attribs = ClampDown(gl, GL_MAX_VERTEX_ATTRIBS, caps.vertex_attribs);
+  caps.vertex_texture_units = ClampDown(gl, GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS,
+                                        caps.vertex_texture_units);
+  caps.fragment_texture_units =
+      ClampDown(gl, GL_MAX_TEXTURE_IMAGE_UNITS, caps.fragment_texture_units);
+  caps.vertex_uniform_vectors = ClampDown(gl, GL_MAX_VERTEX_UNIFORM_VECTORS,
+                                          caps.vertex_uniform_vectors);
+  caps.fragment_uniform_vectors = ClampDown(gl, GL_MAX_FRAGMENT_UNIFORM_VECTORS,
+                                            caps.fragment_uniform_vectors);
+  caps.varying_vectors =
+      ClampDown(gl, GL_MAX_VARYING_VECTORS, caps.varying_vectors);
+  caps.aliased_point_size_max = ClampDownRangeMaxF(
+      gl, GL_ALIASED_POINT_SIZE_RANGE, caps.aliased_point_size_max);
+  caps.aliased_line_width_max = ClampDownRangeMaxF(
+      gl, GL_ALIASED_LINE_WIDTH_RANGE, caps.aliased_line_width_max);
+
+  // The ES3 block. Everything above is an ES2 query and safe on either context.
+  if (es3) {
+    caps.texture_3d_size =
+        ClampDown(gl, GL_MAX_3D_TEXTURE_SIZE, caps.texture_3d_size);
+    caps.array_texture_layers =
+        ClampDown(gl, GL_MAX_ARRAY_TEXTURE_LAYERS, caps.array_texture_layers);
+    caps.vertex_uniform_blocks =
+        ClampDown(gl, GL_MAX_VERTEX_UNIFORM_BLOCKS, caps.vertex_uniform_blocks);
+    caps.fragment_uniform_blocks = ClampDown(gl, GL_MAX_FRAGMENT_UNIFORM_BLOCKS,
+                                             caps.fragment_uniform_blocks);
+    caps.uniform_block_size =
+        ClampDown(gl, GL_MAX_UNIFORM_BLOCK_SIZE, caps.uniform_block_size);
+    caps.draw_buffers = ClampDown(gl, GL_MAX_DRAW_BUFFERS, caps.draw_buffers);
+    caps.color_attachments =
+        ClampDown(gl, GL_MAX_COLOR_ATTACHMENTS, caps.color_attachments);
+    caps.texture_lod_bias =
+        ClampDownF(gl, GL_MAX_TEXTURE_LOD_BIAS, caps.texture_lod_bias);
+    caps.uniform_buffer_offset_alignment =
+        ClampUp(gl, GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT,
+                caps.uniform_buffer_offset_alignment);
+  }
+
+  // The nine derived limits, in the two forms ANGLE writes them in. Each relation is a line a page can
+  // divide out, and each is identical on both backends -- which is why they are computed rather than
+  // claimed:
+  //
+  //   components  = 4 x vectors                renderer11_utils.cpp:1197 / DisplayMtl.mm:836
+  //   varying     = 4 x varying vectors        renderer11_utils.cpp:1254 / DisplayMtl.mm:733
+  //   combined blocks = vertex + fragment      renderer11_utils.cpp:1245
+  //   combined units  = vertex + fragment      renderer11_utils.cpp:1256 / mtl_common.h:145
+  //   combined components = blocks * (blockSize / 4) + components
+  //                                            renderer11_utils.cpp:1248 / DisplayMtl.mm:886
+  caps.combined_texture_image_units =
+      caps.vertex_texture_units + caps.fragment_texture_units;
+  caps.vertex_uniform_components = 4 * caps.vertex_uniform_vectors;
+  caps.fragment_uniform_components = 4 * caps.fragment_uniform_vectors;
+  caps.varying_components = 4 * caps.varying_vectors;
+  caps.combined_uniform_blocks =
+      caps.vertex_uniform_blocks + caps.fragment_uniform_blocks;
+  caps.uniform_buffer_bindings = caps.combined_uniform_blocks;
+  caps.combined_vertex_uniform_components =
+      static_cast<int64_t>(caps.vertex_uniform_blocks) *
+          static_cast<int64_t>(caps.uniform_block_size / 4) +
+      caps.vertex_uniform_components;
+  caps.combined_fragment_uniform_components =
+      static_cast<int64_t>(caps.fragment_uniform_blocks) *
+          static_cast<int64_t>(caps.uniform_block_size / 4) +
+      caps.fragment_uniform_components;
+  return caps;
+}
+
+// Convenience for the call sites, so a getParameter arm reads as one condition:
+//
+//   if (Caps caps; veil_webgl_caps::Resolved(ContextGL(), /*es3=*/false, &caps))
+//     return WebGLAny(script_state, caps.texture_size);
+//   return GetIntParameter(script_state, pname);   // unchanged stock path
+inline bool Resolved(gpu::gles2::GLES2Interface* gl, bool es3, Caps* out) {
+  *out = Resolve(gl, es3);
+  return out->active;
+}
+
+// Extensions the claimed platform cannot have. Subtractive only, and for a reason that is not
+// caution: `getSupportedExtensions()` and `getExtension()` both answer from
+// WebGLRenderingContextBase::disabled_extensions_ through ExtensionSupportedAndAllowed(), so removing
+// a name here moves both and they cannot disagree. *Adding* one has no such choke point -- the list
+// would name an extension `getExtension()` returns null for, which is a contradiction a page finds in
+// one line, so the ASTC/ETC/PVRTC families every Apple GPU has stay absent and are recorded as a
+// residual instead.
+//
+// One entry, and it is settled in this tree rather than from a vendor table: three ANGLE backends set
+// `extensions.multiviewOVR` -- renderer11_utils.cpp:1339, renderergl_utils.cpp:1603,
+// vk_caps_utils.cpp:1329 -- and the Metal backend never mentions it, so GL_OVR_multiview2 exists on
+// this D3D11 host and on no Mac. Blink gates the WebGL extension on exactly that string and names it
+// "OVR_multiview2" (ovr_multiview_2.cc:85, :88), which is the name disabled_extensions_ matches.
+inline constexpr const char* kMacOSAbsentExtensions[] = {"OVR_multiview2"};
+
+struct AbsentExtensions {
+  const char* const* names = nullptr;
+  size_t count = 0;
+};
+
+inline AbsentExtensions ClaimedAbsentExtensions() {
+  if (!Enabled() || ClaimedPlatform() != "macos") {
+    return AbsentExtensions();
+  }
+  return AbsentExtensions{kMacOSAbsentExtensions,
+                          sizeof(kMacOSAbsentExtensions) /
+                              sizeof(kMacOSAbsentExtensions[0])};
+}
+
+}  // namespace veil_webgl_caps
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_VEIL_WEBGL_CAPS_H_

