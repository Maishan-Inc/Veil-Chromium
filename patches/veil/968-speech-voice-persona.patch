+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The speech-synthesis catalogue the claimed platform would report.
+//
+// `speechSynthesis.getVoices()` is installed by the operating system and by its language packs, so it
+// gives away the platform *and* the locale in a single read. Measured on the shipping engine: three
+// `Microsoft ... (zh-CN)` voices on a persona that claims an `en-US` Apple M3 -- Windows voices, for a
+// language the persona does not claim, on a machine that claims not to be Windows.
+//
+// TWO halves, and only one of them is a claim about hardware Veil cannot see:
+//
+// 1. The *shape* is transcribed from this tree, exactly as `963` transcribes ANGLE. A macOS Chrome
+//    builds its list in `content/browser/speech/tts_mac.mm:110-188`: every voice from
+//    `AVSpeechSynthesisVoice.speechVoices`, sorted by name ascending, with the system default voice
+//    moved to index 0; `lang` is a BCP-47 tag; `native` is true for all of them. The mojo layer then
+//    copies `name` into `voiceURI` as well (`content/browser/speech/speech_synthesis_impl.cc:107`)
+//    and marks index 0 as the default, which is why the order below is the observable order and why
+//    the default is a position rather than a flag.
+//
+// 2. The *roster* is a claim, and it is deliberately the smaller one. These are Apple's long-standing
+//    single-name compact voices, one per language, the set that has been on every macOS for a decade.
+//    The modern multi-language novelty voices -- Eddy, Flo, Grandma, Grandpa, Reed, Rocko, Sandy,
+//    Shelley, each shipped in several languages, which is the reason `tts_mac.mm` disambiguates
+//    duplicate names at all -- are **not** claimed here, because their presence depends on the macOS
+//    version and on what the user downloaded. The direction of that error is a true set that is
+//    smaller than a maximal Mac's, never an invented name; a borrowed Mac settles it, and it is the
+//    same host T08 is waiting for.
+//
+// Every name below is unique, which is also why no localised-language suffix is needed: the
+// disambiguation branch in `tts_mac.mm` only fires for a repeated name, so a table with none of them
+// reproduces the same output without depending on an ICU display name for a locale the host may not
+// have. The table is stored **pre-sorted by name**, so a reader sees the order the page will see.
+//
+// A Linux claim reports **no voices at all**. Chrome on Linux enumerates through speech-dispatcher
+// (`content/browser/speech/tts_linux.cc`), which a desktop install frequently does not run, so an
+// empty catalogue is an ordinary Linux reading -- and it is the honest one for Veil, which has no
+// Linux voice roster it can defend. Falling through to the host's Windows SAPI voices would be the
+// contradiction this patch exists to remove, pointing the other way.
+
+#ifndef COMPONENTS_UNGOOGLED_VOICE_PERSONA_H_
+#define COMPONENTS_UNGOOGLED_VOICE_PERSONA_H_
+
+#include <cstddef>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/strings/string_util.h"
+#include "components/ungoogled/platform_claim.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+namespace ungoogled {
+namespace voice_persona {
+
+// One entry of a claimed catalogue. `name` doubles as `voiceURI`, which is what the mojo layer does
+// with a real one.
+struct Voice {
+  std::string name;
+  std::string lang;
+};
+
+struct VoiceRow {
+  const char* name;
+  const char* lang;
+};
+
+// Apple's compact voices, one per language, sorted by name. "Am\xC3\xA9lie" is written as explicit
+// UTF-8 bytes rather than as a literal so the encoding of this file cannot change what the page
+// reads.
+inline constexpr VoiceRow kMacOSVoices[] = {
+    {"Alice", "it-IT"},        {"Alva", "sv-SE"},      {"Am\xC3\xA9lie", "fr-CA"},
+    {"Anna", "de-DE"},         {"Carmit", "he-IL"},    {"Damayanti", "id-ID"},
+    {"Daniel", "en-GB"},       {"Ellen", "nl-BE"},     {"Ioana", "ro-RO"},
+    {"Joana", "pt-PT"},        {"Kanya", "th-TH"},     {"Karen", "en-AU"},
+    {"Kyoko", "ja-JP"},        {"Laura", "sk-SK"},     {"Lekha", "hi-IN"},
+    {"Luciana", "pt-BR"},      {"Maged", "ar-SA"},     {"Mariska", "hu-HU"},
+    {"Meijia", "zh-TW"},       {"Melina", "el-GR"},    {"Milena", "ru-RU"},
+    {"Moira", "en-IE"},        {"Monica", "es-ES"},    {"Nora", "nb-NO"},
+    {"Paulina", "es-MX"},      {"Rishi", "en-IN"},     {"Samantha", "en-US"},
+    {"Sara", "da-DK"},         {"Satu", "fi-FI"},      {"Sinji", "zh-HK"},
+    {"Tessa", "en-ZA"},        {"Thomas", "fr-FR"},    {"Tingting", "zh-CN"},
+    {"Xander", "nl-NL"},       {"Yelda", "tr-TR"},     {"Yuna", "ko-KR"},
+    {"Zosia", "pl-PL"},        {"Zuzana", "cs-CZ"},
+};
+
+// The locale the profile declares, lower-cased, taken from the switches Veil derives from one field.
+// `--accept-lang` first: `chrome/browser/prefs/chrome_command_line_pref_store.cc:50` maps it onto the
+// `kSelectedLanguages` pref, which is the value that becomes `navigator.languages`, so reading the
+// switch here reads the source of the string a page compares this catalogue against rather than a
+// copy of it. `--lang` is the fallback, and an empty answer is possible and handled.
+//
+// Both switch names are string literals on purpose. `kAcceptLang` is declared in
+// `chrome/common/chrome_switches.cc:28` and `kLang` in `ui/base/ui_base_switches.cc`, and neither
+// `components/ungoogled` nor `content/` -- this header's two consumers -- may include `chrome/`.
+inline std::string ClaimedLocale() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line) {
+    return std::string();
+  }
+  std::string value;
+  if (command_line->HasSwitch("accept-lang")) {
+    value = command_line->GetSwitchValueASCII("accept-lang");
+  } else if (command_line->HasSwitch("lang")) {
+    value = command_line->GetSwitchValueASCII("lang");
+  }
+  const size_t comma = value.find(',');
+  if (comma != std::string::npos) {
+    value = value.substr(0, comma);
+  }
+  const size_t semicolon = value.find(';');
+  if (semicolon != std::string::npos) {
+    value = value.substr(0, semicolon);
+  }
+  return base::ToLowerASCII(base::TrimWhitespaceASCII(value, base::TRIM_ALL));
+}
+
+// Which row a macOS configured for `locale` would have selected in System Settings, by the same
+// two-step every locale lookup in this patch set performs: the full tag first, then the language
+// subtag. `-1` when the roster has no voice for that language, which is a real state -- a Mac set to
+// a language Apple ships no voice for still reports the whole roster, with its en-US default.
+inline int DefaultVoiceIndex(const std::string& locale) {
+  if (locale.empty()) {
+    return -1;
+  }
+  for (size_t i = 0; i < std::size(kMacOSVoices); ++i) {
+    if (base::ToLowerASCII(kMacOSVoices[i].lang) == locale) {
+      return static_cast<int>(i);
+    }
+  }
+  const std::string language = locale.substr(0, locale.find('-'));
+  for (size_t i = 0; i < std::size(kMacOSVoices); ++i) {
+    const std::string row = base::ToLowerASCII(kMacOSVoices[i].lang);
+    if (row.substr(0, row.find('-')) == language) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+// The catalogue to present, or false to leave the host's alone.
+//
+// True with an **empty** `out` is a real answer and not a failure: that is the Linux claim, and
+// falling through on it would report Windows voices on a machine claiming Linux.
+inline bool ClaimedVoiceCatalogue(std::vector<Voice>* out) {
+  if (!platform_claim::ShouldPresentOtherPlatform()) {
+    return false;
+  }
+  const std::string claimed = platform_claim::Claimed();
+  out->clear();
+  if (claimed == "linux") {
+    return true;
+  }
+  if (claimed != "macos") {
+    // No roster for this claim -- `android` and `ios` reach no patch in this set, and a Windows claim
+    // on a Windows build is the same-platform case the gate above already returned on.
+    return false;
+  }
+  const int default_index = DefaultVoiceIndex(ClaimedLocale());
+  // `tts_mac.mm` moves the system default voice to the front of the name-sorted list, and the mojo
+  // layer then marks index 0 as `default`. Reproducing the move rather than setting a flag is what
+  // makes the default voice's `lang` agree with `navigator.language` instead of contradicting it.
+  if (default_index >= 0) {
+    out->push_back(Voice{kMacOSVoices[default_index].name, kMacOSVoices[default_index].lang});
+  }
+  for (size_t i = 0; i < std::size(kMacOSVoices); ++i) {
+    if (static_cast<int>(i) == default_index) {
+      continue;
+    }
+    out->push_back(Voice{kMacOSVoices[i].name, kMacOSVoices[i].lang});
+  }
+  return true;
+}
+
+}  // namespace voice_persona
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_VOICE_PERSONA_H_

