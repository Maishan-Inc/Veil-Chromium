+namespace webrtc {
+// Veil 984 -- synthetic mDNS hostnames.
+//
+// Stock Chrome answers a STUN-less gather with `<uuid>.local`; this engine, built with
+// enable_mdns=false, answers with the raw address (see the patch header for why the full
+// mDNS responder is not restored). Names are memoised per process: stable per address,
+// fresh per launch. AddAddress runs on the network thread; the mutex covers the
+// allocator-session threads that may race the first gather.
+namespace {
+std::string VeilMdnsNameFor(const IPAddress& ip) {
+  static absl::NoDestructor<std::map<IPAddress, std::string>> names;
+  static absl::NoDestructor<Mutex> mutex;
+  MutexLock lock(mutex.get());
+  auto it = names->find(ip);
+  if (it != names->end()) {
+    return it->second;
+  }
+  std::string name = CreateRandomUuid() + LOCAL_TLD;
+  names->emplace(ip, name);
+  return name;
+}
