 bool BasicPortAllocator::MdnsObfuscationEnabled() const {
+  // Veil 984: this engine builds with enable_mdns=false, so the responder is always null
+  // and the stock check would report obfuscation off -- which makes SanitizeCandidate keep
+  // the resolved IP and BuildCandidate print it, undoing the synthetic .local hostname
+  // Port::AddAddress installed. Report obfuscation on when 984 is active; the sanitize path
+  // then switches host candidates to their hostname and filters related addresses exactly
+  // as stock Chrome's does.
+  if (webrtc::VeilWebrtcSpoofEnabled()) {
+    return true;
+  }
   return network_manager()->GetMdnsResponder() != nullptr;
 }
 
