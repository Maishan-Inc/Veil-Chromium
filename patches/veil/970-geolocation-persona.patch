     "Geolocation access has been blocked because of a permissions policy "
     "applied to the current document. See https://crbug.com/414348233 for more "
     "details.";
+
+// Veil 970: the persona's declared position, parsed once per renderer process.
+// `--fingerprint-location=lat,lng` is what `000` has declared since the port and what nothing
+// read until this patch; see the patch header. `nullptr` is "no claim" -- the switch is absent,
+// malformed, or outside WGS84 -- and every caller treats it as "answer from the real device
+// service", i.e. stock. `base::NoDestructor` keeps the parse off the exit-time-destructor list.
+const device::mojom::blink::Geoposition* VeilPersonaPosition() {
+  static const base::NoDestructor<std::optional<device::mojom::blink::Geoposition>>
+      position([] {
+        const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+        if (!command_line->HasSwitch(switches::kFingerprintLocation)) {
+          return std::optional<device::mojom::blink::Geoposition>();
+        }
+        const std::string value =
+            command_line->GetSwitchValueASCII(switches::kFingerprintLocation);
+        const size_t comma = value.find(',');
+        if (comma == std::string::npos) {
+          return std::optional<device::mojom::blink::Geoposition>();
+        }
+        double latitude = 0.;
+        double longitude = 0.;
+        if (!base::StringToDouble(value.substr(0, comma), &latitude) ||
+            !base::StringToDouble(value.substr(comma + 1), &longitude)) {
+          return std::optional<device::mojom::blink::Geoposition>();
+        }
+        // WGS84 bounds, the same test `ValidateGeoposition()` applies to a real answer -- a
+        // declaration outside them would produce a position no receiver accepts.
+        if (latitude < -90. || latitude > 90. || longitude < -180. || longitude > 180.) {
+          return std::optional<device::mojom::blink::Geoposition>();
+        }
+        device::mojom::blink::Geoposition fabricated;
+        fabricated.latitude = latitude;
+        fabricated.longitude = longitude;
+        // A hundred metres is a coarse urban fix: precise enough to read as a real network
+        // location, coarse enough that no page can steer a map pin onto a specific building the
+        // declaration cannot name.
+        fabricated.accuracy = 100.;
+        // The kBadAltitude family are Chromium's own "no sensor" sentinels; `CreateGeoposition()`
+        // turns each into `nullopt`, which is what a desktop without the hardware reports.
+        fabricated.altitude = device::mojom::blink::kBadAltitude;
+        fabricated.altitude_accuracy = device::mojom::blink::kBadAccuracy;
+        fabricated.heading = device::mojom::blink::kBadHeading;
+        fabricated.speed = device::mojom::blink::kBadSpeed;
+        // The mojom comment on `timestamp`: "taken from the host computer's system clock (i.e.
+        // from Time::Now(), not the source device's clock)" -- so Now() *is* the stock provenance.
+        fabricated.timestamp = base::Time::Now();
+        return std::optional<device::mojom::blink::Geoposition>(std::move(fabricated));
+      }());
+  return *position ? &**position : nullptr;
+}
 
 Geoposition* CreateGeoposition(
     const device::mojom::blink::Geoposition& position) {
@@ -615,6 +670,22 @@
 }
 
 void Geolocation::QueryNextPosition() {
+  // Veil 970: with a declared position, answer from the declaration instead of waiting on the
+  // device service. The permission flow is untouched -- this method is reached only after
+  // `OnGeolocationPermissionStatusUpdated` reported GRANTED (a denial goes to
+  // `HandlePermissionError()` and never here), so the fabricated position is delivered on exactly
+  // the paths a real one would be. One answer per request, as the real service gives; a
+  // `watchPosition` re-enters through `UpdateGeolocationState()` and receives the same coordinates
+  // with a fresh timestamp, which is what a stationary device produces.
+  if (const auto* persona = VeilPersonaPosition()) {
+    last_position_ = CreateGeoposition(*persona);
+    GetExecutionContext()
+        ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostTask(
+            FROM_HERE,
+            blink::BindOnce(&Geolocation::PositionChanged, WrapPersistent(this)));
+    return;
+  }
   geolocation_->QueryNextPosition(
       blink::BindOnce(&Geolocation::OnPositionUpdated, WrapPersistent(this)));
 }
