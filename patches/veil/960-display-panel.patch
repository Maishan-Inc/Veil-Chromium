index 0000000000..3b7f10c4d2
--- /dev/null
+++ b/components/ungoogled/display_persona.h
@@ -0,0 +1,165 @@
+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The declared display panel, and the work area, colour depth and orientation derived from it.
+//
+// One home for the whole derivation, because five translation units need it: core/frame/screen.cc,
+// core/frame/local_dom_window.cc, core/css/media_values.cc,
+// modules/screen_details/screen_detailed.cc and
+// modules/screen_orientation/screen_orientation_controller.cc. Three copies of a work-area inset
+// table would be three answers to one question, which is the class of bug this patch set has spent
+// two stages removing.
+//
+// Every switch read is `switch > host`: a positive value wins, anything else falls through to the
+// real display. There is no persona rung -- see the patch header for why the counterpart's was
+// dropped.
+
+#ifndef COMPONENTS_UNGOOGLED_DISPLAY_PERSONA_H_
+#define COMPONENTS_UNGOOGLED_DISPLAY_PERSONA_H_
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+namespace ungoogled {
+namespace display_persona {
+
+// The panel a profile declares, in DIPs -- the unit `screen.width` / `screen.height` report and the
+// unit `--window-size` takes. Physical pixels are the panel times the scale factor and are not
+// modelled here: no web-exposed surface reports them directly.
+struct Panel {
+  int width = 0;
+  int height = 0;
+};
+
+// The rectangle a window may occupy, in the declared panel's own coordinates.
+struct WorkArea {
+  int x = 0;
+  int y = 0;
+  int width = 0;
+  int height = 0;
+};
+
+// One reserved strip per claimed shell, in DIPs. These are statements about where an operating
+// system puts its shell -- the only kind of claim Veil's assertion 6 permits -- and each is bounded
+// well inside the 0-200 px that `screen-os-chrome-is-plausible` allows.
+//
+// Windows 11 reserves its taskbar at the bottom: 48 px at 100% scale, which is this build host's own
+// measured value (a 2560x1440 panel reports availHeight 1392). macOS reserves the menu bar at the
+// top and is modelled with the Dock auto-hidden, because the menu bar's height follows from the
+// platform while a Dock's does not -- it follows from settings Veil holds no field for. GNOME
+// reserves its top bar.
+constexpr int kWindowsTaskbarHeight = 48;
+constexpr int kMacOSMenuBarHeight = 25;
+constexpr int kLinuxTopPanelHeight = 27;
+
+// "If the user agent does not know the color depth or does not want to return it for privacy
+// considerations, it should return 24." -- https://drafts.csswg.org/cssom-view/#dom-screen-colordepth
+// Every desktop shell a persona would claim reports 24, and `screen.pixelDepth` is Blink's alias of
+// `colorDepth`, so one derived constant drives two surfaces.
+constexpr int kColorDepth = 24;
+
+// A positive integer switch value, or nothing. Zero and negatives are rejected rather than clamped:
+// a panel of 0 px is not a smaller panel, it is a malformed command line, and falling through to the
+// host is the honest answer to one.
+inline bool PositiveIntSwitch(const char* name, int* out) {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  int value = 0;
+  if (command_line && command_line->HasSwitch(name) &&
+      base::StringToInt(command_line->GetSwitchValueASCII(name), &value) &&
+      value > 0) {
+    *out = value;
+    return true;
+  }
+  return false;
+}
+
+// Both dimensions or neither. A half-declared panel would put a spoofed width beside the host's
+// height, which is a machine narrower or taller than any that exists -- worse than not spoofing.
+inline bool DeclaredPanel(Panel* out) {
+  Panel panel;
+  if (!PositiveIntSwitch(::switches::kFingerprintScreenWidth, &panel.width) ||
+      !PositiveIntSwitch(::switches::kFingerprintScreenHeight, &panel.height)) {
+    return false;
+  }
+  *out = panel;
+  return true;
+}
+
+// The scale factor, parsed as a double so `1`, `1.5` and `2.00` all work. Veil pins the formatting
+// to two decimals so one profile always produces one byte-identical command line, but the engine
+// must not depend on that: a hand-run command line is a supported way to reproduce a capture.
+inline bool DeclaredScaleFactor(double* out) {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  double value = 0;
+  if (command_line &&
+      command_line->HasSwitch(::switches::kFingerprintDeviceScaleFactor) &&
+      base::StringToDouble(command_line->GetSwitchValueASCII(
+                               ::switches::kFingerprintDeviceScaleFactor),
+                           &value) &&
+      value > 0) {
+    *out = value;
+    return true;
+  }
+  return false;
+}
+
+// The platform the profile claims, lower-cased, or empty when it claims none. Same read as `002`,
+// `006` and `011` perform, and the empty case matters: Veil emits `--fingerprint-platform` only
+// alongside a seed, so the caller must have a defined answer for a panel with no claimed platform.
+inline std::string ClaimedPlatform() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line && command_line->HasSwitch(::switches::kFingerprintPlatform)) {
+    return base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(::switches::kFingerprintPlatform));
+  }
+  return std::string();
+}
+
+// The panel minus the claimed shell's one reserved strip.
+//
+// An unclaimed platform falls to the Windows strip rather than to zero, and that is deliberate: this
+// engine is a Windows build, so a bare `--fingerprint-screen-width` with no platform claim is a
+// Windows machine, and a zero strip would report a work area exactly equal to the panel -- a kiosk,
+// which is a louder tell than a taskbar.
+inline WorkArea DeclaredWorkArea(const Panel& panel) {
+  const std::string platform = ClaimedPlatform();
+  int top = 0;
+  int bottom = 0;
+  if (platform == "macos") {
+    top = kMacOSMenuBarHeight;
+  } else if (platform == "linux") {
+    top = kLinuxTopPanelHeight;
+  } else {
+    bottom = kWindowsTaskbarHeight;
+  }
+  const int height = panel.height - top - bottom;
+  return WorkArea{0, top, panel.width, height > 1 ? height : 1};
+}
+
+// A window origin kept inside `[minimum, minimum + room]`, and returned untouched when it already
+// fits. Used for `window.screenX` / `window.screenY`: the position is a real measurement of a real
+// window, so it is only overridden where keeping it would put the window off an edge of a panel the
+// page has been told about.
+inline int ClampOrigin(int origin, int minimum, int room) {
+  const int limit = minimum + (room > 0 ? room : 0);
+  if (origin < minimum) {
+    return minimum;
+  }
+  return origin > limit ? limit : origin;
+}
+
+// Blink's own rule, from `ScreenOrientationController::ComputeOrientation` at rotation 0: a display
+// taller than it is wide is portrait. Squares are landscape, which is Blink's answer too.
+inline bool IsPortrait(const Panel& panel) {
+  return panel.height > panel.width;
+}
+
+}  // namespace display_persona
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_DISPLAY_PERSONA_H_

