+  //
+  // Which values are accepted, and why one outside the set falls through here instead of being
+  // clamped, is components/ungoogled/device_memory_persona.h.
+  if (std::optional<float> claimed = ungoogled::device_memory_persona::ClaimedGb()) {
+    return *claimed;
