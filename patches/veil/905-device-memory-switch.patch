new file mode 100644
index 0000000000..db5270a17e
--- /dev/null
+++ b/components/ungoogled/device_memory_persona.h
@@ -0,0 +1,87 @@
+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// How much RAM does the claimed machine have, and which values can a Chrome 151 actually report?
+//
+// `005` replaced `NavigatorDeviceMemory::deviceMemory()`'s body with `return 8;` -- no switch, no
+// seed, no fall-through -- so every Veil profile reported 8 GB and no stored value could be honoured
+// (measured, Veil/docs/MIGRATION-UNGOOGLED.md 5.1e). `905` is the correction: the switch is read
+// here, and "unset" means the host's real approximation, which is exactly what `005` already does
+// for `hardwareConcurrency` one file away. One rule for the two fields of one block.
+//
+// THE REACHABLE SET, and it is not the one the counterpart assumes.
+// `third_party/blink/public/common/device_memory/approximated_device_memory.cc:33-79` rounds the
+// host's physical memory to the *nearer* neighbouring power of two, divides by 1024 to get GB, and
+// then clamps -- and in Chromium 151 the clamp is `kMinMemory = 2.0f`, `kMaxMemory = 32.0f` on
+// desktop (1 and 8 on Android), with a comment citing crbug.com/454354290 for the update. So the
+// values a desktop Chrome 151 can report are exactly:
+//
+//     2, 4, 8, 16, 32
+//
+// Measured 2026-08-28: stock Chrome 151 on this 32 GiB host reports **32**. clearcote's `030` clamps
+// its result to 8 with the comment "real Chrome never reports >8"; that was true of an older
+// Chromium and is false of this one, and a persona reporting 8 where the modal desktop reports 16 or
+// 32 is a value chosen against a stale spec. This header takes the set from the file that computes
+// it instead.
+//
+// A value outside the set **falls through to the host** rather than being clamped into it. Clamping
+// would silently turn a typo into a different machine; falling through leaves the true value, which
+// is the same direction `906` and `963` take -- never invent, and prefer the host's truth to a guess.
+// Veil's own `validate` refuses anything but the five, so a command line carrying a sixth value is
+// hand-written and the engine's job is only to not report something impossible.
+//
+// The switch is declared in `ungoogled_switches` and **is** in
+// `RenderProcessHostImpl::PropagateBrowserCommandLineToRenderer`'s allow-list, because unlike `961`'s
+// touch-point switch this one is read in a renderer: `NavigatorDeviceMemory` is Blink. The two
+// patches land in the same phase and answer that question differently on purpose -- a switch is
+// propagated when a process that reads it needs it, and not otherwise (6.9).
+
+#ifndef COMPONENTS_UNGOOGLED_DEVICE_MEMORY_PERSONA_H_
+#define COMPONENTS_UNGOOGLED_DEVICE_MEMORY_PERSONA_H_
+
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+namespace ungoogled {
+namespace device_memory_persona {
+
+// The five values `ApproximatedDeviceMemory` can produce on a desktop build, smallest first. Kept as
+// an explicit list rather than a "power of two in [2, 32]" test so the set is readable at a glance
+// and so a future clamp change upstream shows up as a diff here rather than as a silent widening.
+inline constexpr float kReportableGb[] = {2.0f, 4.0f, 8.0f, 16.0f, 32.0f};
+
+// `--fingerprint-device-memory=<n>`, if present and one of the five. `std::nullopt` means "no usable
+// claim", and every caller's answer to that is the host's own value.
+//
+// Parsed as a double and compared exactly: the five are all small integers, so every one of them is
+// representable without rounding and an exact comparison is what makes "8.0" and "8" the same claim
+// while "6" is neither.
+inline std::optional<float> ClaimedGb() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line ||
+      !command_line->HasSwitch(::switches::kFingerprintDeviceMemory)) {
+    return std::nullopt;
+  }
+  double requested = 0;
+  if (!base::StringToDouble(command_line->GetSwitchValueASCII(
+                                ::switches::kFingerprintDeviceMemory),
+                            &requested)) {
+    return std::nullopt;
+  }
+  for (float reportable : kReportableGb) {
+    if (static_cast<double>(reportable) == requested) {
+      return reportable;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace device_memory_persona
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_DEVICE_MEMORY_PERSONA_H_

