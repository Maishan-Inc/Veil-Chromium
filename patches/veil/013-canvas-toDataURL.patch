# Changes: regenerated against the post-series 151.0.7922.137 tree. The 144 spelling applies, but its
#          second hunk lands with fuzz 1 (151 inserted cc/trees/layer_tree_host.h after
#          cc/layers/texture_layer.h, so the trailing context no longer matched). The fuzzy outcome
#          was read back first and was correct -- components/ungoogled/ungoogled_switches.h landed
#          ahead of build/build_config.h, where the patch puts it -- then regenerated so no future
#          reader has to repeat that check and so build.py's fuzz-2 ceiling stops being a liability.
#          Content is byte-identical to the fuzzy result.
#
# Noises canvas.toDataURL. In HTMLCanvasElement::ToDataURLInternal, before the ImageDataBuffer is
# built, the snapshot is read into an independent RGBA_8888/unpremul buffer, that copy is passed
# through StaticBitmapImage::ShuffleSubchannelColorData, and a fresh StaticBitmapImage is built from
# it. The canvas's own backing store is never touched. Gated on --fingerprint=<seed>, with
# --disable-spoofing=canvas as the opt-out.
#
# Ordering: this must land after 012-canvas-get-image-data, which is what replaces bromite's
# per-call base::RandDouble() shuffle body with a seed-derived one. Measured before it, the two
# toDataURL leaves diverge between the main frame and a cross-site iframe and the cross-realm
# assertion fails -- see Veil/docs/MIGRATION-UNGOOGLED.md 5.1g.
#
# 012 does not cover this surface: ImageDataBuffer::ToDataURL calls ImageEncoder::Encode directly,
# not the EncodeImage that 012 hooks, so toDataURL is this patch's alone.
#
--- a/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
+++ b/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
@@ -33,6 +33,7 @@
 #include <memory>
 #include <utility>
 
+#include "base/command_line.h"
 #include "base/feature_list.h"
 #include "base/functional/callback_helpers.h"
 #include "base/location.h"
@@ -42,6 +43,7 @@
 #include "base/numerics/safe_conversions.h"
 #include "base/trace_event/trace_event.h"
 #include "base/trace_event/typed_macros.h"
+#include "components/ungoogled/ungoogled_switches.h"
 #include "build/build_config.h"
 #include "cc/layers/texture_layer.h"
 #include "cc/trees/layer_tree_host.h"
@@ -1292,6 +1294,56 @@
 
   scoped_refptr<StaticBitmapImage> image_bitmap = Snapshot(source_buffer);
   if (image_bitmap) {
+
+    // 添加指纹保护：在创建 ImageDataBuffer 之前修改像素数据副本
+    const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+    if (command_line->HasSwitch(switches::kFingerprint) &&
+        (!command_line->HasSwitch(switches::kDisableSpoofing) ||
+         command_line->GetSwitchValueASCII(switches::kDisableSpoofing).find("canvas") == std::string::npos)) {
+
+      // 获取图像的像素数据进行修改（创建完全独立的副本）
+      SkImageInfo image_info = SkImageInfo::Make(
+          image_bitmap->width(),
+          image_bitmap->height(),
+          kRGBA_8888_SkColorType,  // 使用标准的RGBA格式
+          kUnpremul_SkAlphaType);
+
+      // 创建独立的像素缓冲区副本
+      size_t row_bytes = image_info.minRowBytes();
+      size_t buffer_size = image_info.computeMinByteSize();
+
+      if (buffer_size > 0 && buffer_size <= partition_alloc::MaxDirectMapped()) {
+        std::vector<uint8_t> pixel_buffer(buffer_size);
+
+        // 从原始图像读取像素数据到我们的副本中
+        PaintImage original_paint_image = image_bitmap->PaintImageForCurrentFrame();
+        if (original_paint_image.readPixels(image_info, pixel_buffer.data(), row_bytes, 0, 0)) {
+
+          // 对副本应用指纹保护修改（不影响原始数据）
+          StaticBitmapImage::ShuffleSubchannelColorData(
+              pixel_buffer.data(), image_info, 0, 0);
+
+          // 用修改后的像素数据创建完全新的图像对象
+          sk_sp<SkData> modified_data = SkData::MakeWithCopy(pixel_buffer.data(), buffer_size);
+          if (modified_data) {
+            sk_sp<SkImage> modified_sk_image = SkImages::RasterFromData(
+                image_info, modified_data, row_bytes);
+
+            if (modified_sk_image) {
+              // 创建新的 StaticBitmapImage，使用通用的创建方法
+              PaintImage modified_paint_image = PaintImageBuilder::WithDefault()
+                  .set_id(PaintImage::GetNextId())
+                  .set_image(modified_sk_image, PaintImage::GetNextContentId())
+                  .TakePaintImage();
+
+              image_bitmap = StaticBitmapImage::Create(
+                  modified_paint_image, image_bitmap->Orientation());
+            }
+          }
+        }
+      }
+    }
+
     std::unique_ptr<ImageDataBuffer> data_buffer =
         ImageDataBuffer::Create(image_bitmap);
     if (!data_buffer)
