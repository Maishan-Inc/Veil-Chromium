+// Copyright (c) 2026 The Veil Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// 966 -- the per-origin farbling seed.
+//
+// Ported from clearcotelabs/clearcote-browser's 001-farble-seed-core.patch (BSD-3-Clause, see
+// CREDITS.md): one global seed from --fingerprint=<seed>, mixed with the page's registrable
+// domain (eTLD+1), produces a 64-bit seed that is stable per (profile, origin) across restarts
+// and distinct across origins. The mixing function below is 001's, verbatim in its arithmetic;
+// what is deliberately NOT taken is 001's PersonaProfile struct (6.9: one identity, one source,
+// and the source is the one the UI can name) and its --disable-fingerprint-noise switch (Veil's
+// opt-out vocabulary is --disable-spoofing, checked by each surface's own gate as before).
+//
+// The domain is the eTLD+1 via net's registry-controlled-domain list -- the same list
+// SameDomainOrHost uses for first-party detection in this tree (local_dom_window.cc). Hosts with
+// no registry entry (IP literals, localhost, file://) hash under the host itself, so the
+// harness's 127.0.0.1 / localhost pair -- two sites to Chromium -- yields two distinct seeds.
+
+#ifndef COMPONENTS_UNGOOGLED_FARBLE_SEED_H_
+#define COMPONENTS_UNGOOGLED_FARBLE_SEED_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/hash/hash.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+
+namespace ungoogled {
+namespace farble {
+
+inline uint32_t GlobalSeed() {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd->HasSwitch(switches::kFingerprint)) {
+    return 0u;
+  }
+  const std::string raw = cmd->GetSwitchValueASCII(switches::kFingerprint);
+  uint64_t parsed = 0;
+  if (base::StringToUint64(raw, &parsed)) {
+    return static_cast<uint32_t>(parsed);
+  }
+  return base::PersistentHash(raw);
+}
+
+// 001's mixing: domain hash -> high word (biased by the global seed), hashed low word, and the
+// global seed folded into the top bits. Same (seed, domain) pair -> same 64 bits in every
+// process and every run; distinct domains decorrelate.
+inline uint64_t Seed64(std::string_view registrable_domain) {
+  const uint32_t global_seed = GlobalSeed();
+  const uint32_t dhash = base::PersistentHash(registrable_domain);
+  const uint32_t high = dhash + global_seed - 1u;
+  const uint32_t low = base::PersistentHash(base::byte_span_from_ref(high));
+  return (static_cast<uint64_t>(high) << 32) ^ static_cast<uint64_t>(low) ^
+         (static_cast<uint64_t>(global_seed) << 16);
+}
+
+// Decimal-ASCII rendering, for the std::hash<std::string> per-pixel/per-frame keys the noise
+// sites already build.
+inline std::string SeedString(std::string_view registrable_domain) {
+  return base::NumberToString(Seed64(registrable_domain));
+}
+
+// eTLD+1 for a host, or the host itself when the registry list answers nothing. An empty host
+// (an opaque origin) hashes to a stable fallback, which is what 001 specifies.
+inline std::string DomainForHost(std::string_view host) {
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          host, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return domain.empty() ? std::string(host) : domain;
+}
+
+}  // namespace farble
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_FARBLE_SEED_H_
